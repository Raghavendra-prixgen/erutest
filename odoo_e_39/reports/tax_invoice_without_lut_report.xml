                                                <span t-if="line.price_unit" t-field="line.price_unit" t-options="{'widget': 'float', 'precision': 2}"/>
                                            </t>
                                            <t t-else="">
                                                <t t-if="o.state == 'posted'">
                                                    <t t-set="price" t-value="line.price_unit * o.y_exchange_rate"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="conversion_factor" t-value="1 / line.currency_rate"/>
