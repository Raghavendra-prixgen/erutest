                                        </td>
                                        <td colspan="1"
                                            style="border:1px solid black;text-align:center;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                            <span t-if="line.quantity"
                                                t-field="line.quantity"
                                                t-options="{'widget': 'float', 'precision': 2}" />
                                        </td>

                                        <td colspan="1"
                                            style="border:1px solid black;text-align:center;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                            <span t-if="line.product_id.uom_id"
                                                t-field="line.product_id.uom_id" />

