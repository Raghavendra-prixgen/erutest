                        </table>
                        <div style="page-break-after:always"></div>
                        <table style="font-size: 11px; width: 100%; border: 1px solid black; padding-left: 10px;">
                        <t t-if="o.company_id.parent_id">
                            <t t-if="o.invoice_date and o.company_id.parent_id.partner_id.y_lut_valid_till">
                                <t t-set="is_greater" t-value="o.company_id.parent_id.partner_id.y_lut_valid_till > o.invoice_date" />
                                <t t-if="is_greater">
                            <tr>
