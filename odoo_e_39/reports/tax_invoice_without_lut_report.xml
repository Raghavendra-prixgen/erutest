                                            style="border:1px solid black;text-align:center;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                            <span t-field="line.discount" />

                                        </td>
                                        <t t-if="o.company_id.parent_id">
                                            
                                            
                                            
                                            <t t-if="o.invoice_date and o.company_id.parent_id.partner_id.y_lut_valid_till">
                                                <t t-set="is_greater" t-value="o.invoice_date > o.company_id.parent_id.partner_id.y_lut_valid_till" />
                                                        <t t-if="is_greater">
                                                        <td colspan="1"
                                                            style="border:parent_id1px solid black;text-align:right;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                                            <t t-if="o.currency_id.name == 'INR'">
                                                                <span  t-field="o.currency_id.symbol"/>
                                                                <span t-if="line.price_subtotal" t-field="line.price_subtotal" t-options="{'widget': 'float', 'precision': 2}"/>
                                                            </t>
                                                            <t t-else="">
                                                                <t t-if="o.state == 'posted'">
                                                                    <t t-set="price_subtotal" t-value="line.price_subtotal * o.y_exchange_rate"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <t t-set="conversion_factor" t-value="1 / line.currency_rate"/>
                                                                    <t t-set="price_subtotal" t-value="line.price_subtotal * conversion_factor"/>
                                                                </t>
                                                                <t t-esc="'₹'"/><span t-esc="price_subtotal" t-options="{'widget': 'float', 'precision': 2}"/>
                                                            </t>
                                                        </td>
                                                        <td colspan="1" style="border:1px solid black;text-align:right;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                                            <t t-foreach="taxes_dict[line.id]['taxes']" t-as="tax">
                                                                <span t-esc="tax['name']"/>
                                                                <br/>
                                                            </t>
                                                        </td>
                                                        <td colspan="1" style="border:1px solid black;text-align:right;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                                            <t t-if="o.currency_id.name == 'INR'">
                                                                <span t-field="o.currency_id.symbol"/>
                                                                <span t-esc="taxes_dict[line.id]['total_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                                            </t>
                                                            <t t-else="">
                                                                <t t-if="o.state == 'posted'">
                                                                    <t t-esc="'₹'"/><span t-esc="taxes_dict[line.id]['total_amount'] * o.y_exchange_rate" t-options="{'widget': 'float', 'precision': 2}"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <t t-set="conversion_factor" t-value="1 / line.currency_rate"/>
                                                                    <t t-esc="'₹'"/><span t-esc="taxes_dict[line.id]['total_amount'] * conversion_factor" t-options="{'widget': 'float', 'precision': 2}"/>
                                                                </t>
                                                            </t>
                                                        </td>
                                                    </t>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <t t-if="o.invoice_date and o.company_id.partner_id.y_lut_valid_till">
                                                    <t t-set="is_greater" t-value="o.invoice_date > o.company_id.partner_id.y_lut_valid_till" />
                                                    <t t-if="is_greater">
                                                <td colspan="1"
                                                    style="border:parent_id1px solid black;text-align:right;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                                    <t t-if="o.currency_id.name == 'INR'">
                                                        <span  t-field="o.currency_id.symbol"/>
                                                        <span t-if="line.price_subtotal" t-field="line.price_subtotal" t-options="{'widget': 'float', 'precision': 2}"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-if="o.state == 'posted'">
                                                            <t t-set="price_subtotal" t-value="line.price_subtotal * o.y_exchange_rate"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-set="conversion_factor" t-value="1 / line.currency_rate"/>
                                                            <t t-set="price_subtotal" t-value="line.price_subtotal * conversion_factor"/>
                                                        </t>
                                                        <t t-esc="'₹'"/><span t-esc="price_subtotal" t-options="{'widget': 'float', 'precision': 2}"/>
                                                    </t>
                                                </td>
                                                <td colspan="1" style="border:1px solid black;text-align:right;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                                    <t t-foreach="taxes_dict[line.id]['taxes']" t-as="tax">
                                                        <span t-esc="tax['name']"/>
                                                        <br/>
                                                    </t>
                                                </td>
                                                <td colspan="1" style="border:1px solid black;text-align:right;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                                    <t t-if="o.currency_id.name == 'INR'">
                                                        <span t-field="o.currency_id.symbol"/>
                                                        <span t-esc="taxes_dict[line.id]['total_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-if="o.state == 'posted'">
                                                            <t t-esc="'₹'"/><span t-esc="taxes_dict[line.id]['total_amount'] * o.y_exchange_rate" t-options="{'widget': 'float', 'precision': 2}"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-set="conversion_factor" t-value="1 / line.currency_rate"/>
                                                            <t t-esc="'₹'"/><span t-esc="taxes_dict[line.id]['total_amount'] * conversion_factor" t-options="{'widget': 'float', 'precision': 2}"/>
                                                        </t>
                                                    </t>
                                                </td>
                                            </t>
                                        </t>
                                    </t>
                                        <td colspan="1"
                                            style="border:1px solid black;text-align:right;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                            <t t-if="o.currency_id.name == 'INR'">
                                                <t t-esc="o.currency_id.symbol"/> 
                                                <span t-if="line.price_total" t-field="line.price_total" t-options="{'widget': 'float', 'precision': 2}"/>
                                            </t>
                                            <t t-else="">
                                                <t t-if="o.state == 'posted'">
                                                    <t t-set="price_total" t-value="line.price_total * o.y_exchange_rate"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="conversion_factor" t-value="1 / line.currency_rate"/>
                                                    <t t-set="price_total" t-value="line.price_total * conversion_factor"/>
                                                </t>
                                                <t t-esc="'₹'"/> <span t-esc="price_total" t-options="{'widget': 'float', 'precision': 2}"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                                <tr style="border-bottom:1px solid black;page-break-inside:avoid;">
                                    <th colspan="8" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                        Grand Total(in INR) &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;
                                        <span t-if="o.state == 'posted'">
                                            Exchange Rate: <t t-esc="o.y_exchange_rate" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </span>
                                        <span t-else="">
                                            <t t-set="conversion_factor" t-value="1 / line.currency_rate"/>
                                            Exchange Rate: <t t-esc="conversion_factor" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </span>
                                    </th>
                                    <t t-if="o.company_id.parent_id">
                                        <t t-if="o.invoice_date and o.company_id.parent_id.partner_id.y_lut_valid_till">
                                            <t t-set="is_greater" t-value="o.invoice_date > o.company_id.parent_id.partner_id.y_lut_valid_till" />
                                            <t t-if="is_greater">
                                        <td colspan="1"
                                        style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                        <t t-if="o.currency_id.name == 'INR'">
                                            <t t-esc="o.currency_id.symbol"/> 
                                            <span t-if="o.amount_untaxed" t-field="o.amount_untaxed" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </t>
                                        <t t-else="">
                                            
                                            <span><t t-esc="'₹'"/>&#160;<span t-esc="o.amount_untaxed_signed" t-options="{'widget': 'float', 'precision': 2}"/></span>
                                        </t>
                                        </td>
                                        <td colspan="1"
                                        style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                        
                                        </td>
                                        <td colspan="1"
                                        style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                        
                                        <t t-if="o.currency_id.name == 'INR'">
                                            <t t-esc="o.currency_id.symbol"/> 
                                            <span t-if="o.amount_tax" t-field="o.amount_tax" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </t>
                                        <t t-else="">
                                            
                                            <span><t t-esc="'₹'"/>&#160;<span t-esc="o.amount_tax_signed" t-options="{'widget': 'float', 'precision': 2}"/></span>
                                        </t>
                                        </td>
                                        </t>
                                    </t>
                                    </t>
                                   
                                    
                                    
                                <t t-else="">
                                    <t t-if="o.invoice_date and o.company_id.partner_id.y_lut_valid_till">
                                        <t t-set="is_greater" t-value="o.invoice_date > o.company_id.partner_id.y_lut_valid_till" />
                                    <t t-if="is_greater">
                                <td colspan="1"
                                style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                <t t-if="o.currency_id.name == 'INR'">
                                    <t t-esc="o.currency_id.symbol"/> 
                                    <span t-if="o.amount_untaxed" t-field="o.amount_untaxed" t-options="{'widget': 'float', 'precision': 2}"/>
                                </t>
                                <t t-else="">
                                    
                                    <span><t t-esc="'₹'"/>&#160;<span t-esc="o.amount_untaxed_signed" t-options="{'widget': 'float', 'precision': 2}"/></span>
                                </t>
                                </td>
                                <td colspan="1"
                                style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                
                                </td>
                                <td colspan="1"
                                style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                
                                <t t-if="o.currency_id.name == 'INR'">
                                    <t t-esc="o.currency_id.symbol"/> 
                                    <span t-if="o.amount_tax" t-field="o.amount_tax" t-options="{'widget': 'float', 'precision': 2}"/>
                                </t>
                                <t t-else="">
                                    
                                    <span><t t-esc="'₹'"/>&#160;<span t-esc="o.amount_tax_signed" t-options="{'widget': 'float', 'precision': 2}"/></span>
                                </t>
                                </td>
                                </t>
                            </t>
                            </t>
                                    <td colspan="1"
                                    style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                    <t t-if="o.currency_id.name == 'INR'">
                                        <t t-esc="o.currency_id.symbol"/> 
                                        <span t-if="o.amount_total" t-field="o.amount_total" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </t>
                                    <t t-else="">
                                        
                                        <span><t t-esc="'₹'"/>&#160;<span t-esc="o.amount_total_signed" t-options="{'widget': 'float', 'precision': 2}"/></span>
                                    </t>
                                    </td>
                                </tr>
                                <tr style="border-bottom:1px solid black;">
                                    <td colspan="12"
                                    style="border:1px solid black;text-align:left;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:100%">
                                        <span>
