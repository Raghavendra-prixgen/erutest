<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_tax_invoice_report_without_lut" model="report.paperformat">
        <field name="name">Tax Invoice Report</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">169</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">155</field>
        <field name="dpi">90</field>
    </record>

    <record id="custom_tax_invoice_report_format_without_lut" model="ir.actions.report">
        <field name="name">Tax Invoice Report With / Without LUT</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_e_39.eruvaka_tax_invoice_report_without_lutt</field>
        <field name="report_file">odoo_e_39.eruvaka_tax_invoice_report_without_lutt</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="odoo_e_39.custom_tax_invoice_report_without_lut" />
    </record>

    <template id='eruvaka_tax_invoice_report_without_lutt'>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-call="odoo_e_39.external_layout_for_eruvaka_header_footer_without_lut">
                    <div class="page">
                    
                        
                        <table colspan="12" class="table table-sm m-0 p-0 table-borderless"
                            style="border:1px solid black;border-top:none;font-family: Century Gothic;width:100%;">
                            
                            <thead>

                            <tr style="border-bottom:1px solid black;">
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-bottom:1px solid black;vertical-align:middle;font-size:11px;"> Sl.No.</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Code</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Product</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">HSN / SAC</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Quantity</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">UOM</th>
                               
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Price</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Dis %</th>
                                <t t-if="o.company_id.parent_id">
                                    
                                    
                                    
                                    <t t-if="o.invoice_date and o.company_id.parent_id.partner_id.y_lut_valid_till">
                                        <t t-set="is_greater" t-value="o.invoice_date > o.company_id.parent_id.partner_id.y_lut_valid_till" />
                                            <t t-if="is_greater">
                                                    <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Taxable Value</th>
                                                    <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Tax Rate</th>
                                                    <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Tax Amount</th>
                                                </t>
                                            </t>
                                </t>
                                <t t-else="">
                                    <t t-if="o.invoice_date and o.company_id.partner_id.y_lut_valid_till">
                                        <t t-set="is_greater" t-value="o.invoice_date > o.company_id.partner_id.y_lut_valid_till" />
                                            <t t-if="is_greater">                                                    
                                                    <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Taxable Value</th>
                                                    <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Tax Rate</th>
                                                    <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Tax Amount</th>
                                                </t>
                                            </t>
                                        </t>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Total</th>
                            </tr>
                            </thead>
                            <tbody>
                                <t t-set="sl" t-value="1" />
                                <t t-set="taxes_dict" t-value="o.tax_calculation()" />
                               
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <tr style="border-bottom:1px solid black;border-top:none;page-break-inside:avoid;">
                                        <td colspan="1"
                                            style="border:1px solid black;text-align:center;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                            <span t-esc="sl" />
                                            <t t-set="sl" t-value="sl+1" />
                                        </td>
                                        <td colspan="1"
                                            style="border:1px solid black;text-align:center;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                            <span t-if="line.product_id.default_code"
                                                t-field="line.product_id.default_code" />

                                        </td>
                                        <td colspan="1" rowspan="1"
                                            style="border:1px solid black;text-align:center;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;word-wrap: break-word; max-width:85px;">
                                            <span t-if="line.product_id.name"
                                                t-field="line.product_id.name" />
                                        </td>
                                        <td colspan="1"
                                            style="border:1px solid black;text-align:center;font-size:11px;font-family: Century Gothic;border-right:1px solid black;border-bottom:none;border-top:none;">
                                            <span t-if="line.product_id.l10n_in_hsn_code"
