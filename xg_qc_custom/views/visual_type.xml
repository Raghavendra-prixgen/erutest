<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="visual_type_view_form" model="ir.ui.view">
        <field name="name">visual.type.view.form</field>
        <field name="model">visual.type</field>
        <field name="arch" type="xml">
            <form string="Visual Type">
                <sheet>
                    <group>
                        <group>
                            <field name="y_code"/>
                        </group>
                        <group>
                            <field name="y_description"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>

        </field>
    </record>

    <record id="visual_type_view_tree" model="ir.ui.view">
        <field name="name">visual.type.view.tree</field>
        <field name="model">visual.type</field>
        <field name="arch" type="xml">
            <tree string="Visual Type">
                <field name="y_code" />
                <field name="y_description"/>
            </tree>
        </field>
    </record>

    <record id="visual_type_action" model="ir.actions.act_window">
        <field name="name">Visual Types</field>
        <field name="res_model">visual.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="visual_group_view_form" model="ir.ui.view">
        <field name="name">visual.group.view.form</field>
        <field name="model">visual.group</field>
        <field name="arch" type="xml">
            <form string="Visual Group">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="y_code"  widget="many2many_tags" />
                        </group>
                        <group>
                            <field name="y_description" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="visual_group_view_tree" model="ir.ui.view">
        <field name="name">visual.group.view.tree</field>
        <field name="model">visual.group</field>
        <field name="arch" type="xml">
            <tree string="Visual Group">
                <field name="name" />
                <field name="y_code" widget="many2many_tags" />
                <field name="y_description" />
            </tree>
        </field>
    </record>
    <record id="visual_group_action" model="ir.actions.act_window">
        <field name="name">Visual Groups</field>
        <field name="res_model">visual.group</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <menuitem id="visual_type_menu" name="Visual Types" parent="quality_control.menu_quality_configuration" action="visual_type_action" sequence="100"/>
    <menuitem id="visual_group_menu" name="Visual Groups" parent="quality_control.menu_quality_configuration" action="visual_group_action" sequence="101"/>

</odoo>
