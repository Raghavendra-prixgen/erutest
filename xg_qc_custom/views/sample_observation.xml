<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="instrument_inherit_quality_point" model="ir.ui.view">
        <field name="name">quality.point.view.form.inherit.instrument</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality.quality_point_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="before">
                <field name="y_instrument_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" />
                <field name="y_visual_group_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" invisible="measure_frequency_type != 'all' or test_type not in ['passfail','picture']" />
            </xpath>
        </field>
    </record>

    <record id="quality_check_view_form_inherit_observation" model="ir.ui.view">
        <field name="name">quality.check.view.form.inherit.observation</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <div class="oe_button_box" name="sample_observation_button_box">
                    <button 
                        name="button_sample_observation_view"  type="object" 
                        class="oe_stat_button" icon="fa-check-square" string="Sample Observations" invisible="not y_observation_create"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='measure_on']" position="after">
                <field name="y_observation_create" invisible="1" />
                <field name="y_visual_group_description" readonly="1"/>
            </xpath>

        </field>
    </record>

    <record id="inspection_sheet_form_view_observation" model="ir.ui.view">
        <field name="name">inspection.sheet.view.form.inherit.observation</field>
        <field name="model">inspection.sheet</field>
        <field name="inherit_id" ref="quality_control_base.inspection_sheet_form_view"/> 
        <field name="arch" type="xml">
            <xpath expr="//notebook/page//tree/button[@name='do_alert']" position="after">
                <field name="y_observation_create" column_invisible="1" />
                <button name="action_see_alerts" icon="fa-bell" type="object" invisible="not alert_ids" style="color:red;"  help="See alerts" />
                <button name="button_sample_observation_view" type="object" icon="fa-eye" help="Sample Observations" invisible="not y_observation_create" />
            </xpath>
        </field>
    </record>

    <record id="view_sample_observation_form" model="ir.ui.view">
        <field name="name">Sample Observation Form</field>
        <field name="model">sample.observation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Process" name="sample_observation_process" type="object" class="oe_highlight" invisible="y_state != 'draft'" />
                    <field name="y_state" widget="statusbar" statusbar_visible="draft,process,cancel" statusbar_colors="draft=bg-red-500,process=bg-yellow-500,cancel=bg-red-500" />
                </header>
                <sheet>

                    <div class="oe_title"><h2><field name="name" readonly="1"/></h2></div>

                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="y_product_id" readonly="1" />
                            <field name="y_check_id"  readonly="1" />
                            <field name="y_test_type" invisible="1" />
                            <field name="y_po_ref" readonly="1" />
                            <field name="y_lot_id" readonly="1" />
                            <field name="y_lot_qty" readonly="1" />
                            <field name="y_inspection_approved_date" readonly="1" />
                        </group>
                        <group>
                            <field name="y_partner_id" readonly="0" />
                            <field name="y_test_type_id" readonly="1" />
                            <field name="y_grn_ref" readonly="1" />
                            <field name="y_sample_plan_id"  readonly="1" />
                            <field name="y_sample_size_dimensional" readonly="1" invisible="y_test_type != 'measure'" />
                            <field name="y_sample_size_visual" readonly="1" invisible="y_test_type == 'measure'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Sample Observations" >
                            <field name="y_sample_observation_line_ids" widget="section_and_note_one2many" readonly="y_state == 'process'">
                                <tree editable="bottom" width="100">
                                    <field name="name" />
                                    <field name="y_title" width="100" readonly="1" />
                                    <field name="y_measure" width="100" column_invisible="parent.y_test_type != 'measure'"/>
                                    <field name="y_norm" width="100"  readonly="1" column_invisible="1"/>
                                    <field name="y_norm_unit" width="100" readonly="1" column_invisible="1"/>
                                    <field name="y_tolerance_min" width="100" readonly="1" column_invisible="1"/>
                                    <field name="y_tolerance_max" width="100" readonly="1" column_invisible="1"/>
                                    <field name="y_pass_or_fail_boolean" width="100" column_invisible="1"/>
                                    <button name="pass_btn" icon="fa-check-circle" type="object" column_invisible="parent.y_state in ['cancel','process'] or parent.y_test_type in ['measure']"  invisible="y_pass_or_fail_boolean"/>
                                    <button name="fail_btn" type="object" icon="fa-times-circle" style="color:red" column_invisible="parent.y_state in ['cancel','process'] or parent.y_test_type in ['measure']" invisible="y_pass_or_fail_boolean"/>

                                    <field name="y_remarks" width="100"/>
                                    <field name="y_state" width="100" widget="badge" decoration-success="y_state == 'pass'" decoration-info="y_state == 'to_do'" decoration-danger="y_state == 'fail'" decoration-muted="y_state == 'cancelled'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sample_observation_tree" model="ir.ui.view">
        <field name="name">sample.observation.view.tree</field>
        <field name="model">sample.observation</field>
        <field name="arch" type="xml">
            <tree string="Sample Observation">
                <field name="name" />
                <field name="y_product_id" />
            </tree>
        </field>
    </record>
    

    <record id="view_sample_observation_kanban" model="ir.ui.view">
        <field name="name">sample.observation.kanban</field>
        <field name="model">sample.observation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="y_state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="y_product_id"/>
                <field name="y_partner_id"/>
                <field name="y_state"/>
                <field name="y_inspection_approved_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="y_state" widget="label_selection" 
                                           options="{'classes': {'draft': 'bg-info', 'process': 'bg-success', 'cancel': 'bg-danger'}}"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="y_product_id"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="y_partner_id"/>
                                    </div>
                                </div>
                                <div class="text-muted">
                                    <field name="y_inspection_approved_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Pivot View -->
    <record id="view_sample_observation_pivot" model="ir.ui.view">
        <field name="name">sample.observation.pivot</field>
        <field name="model">sample.observation</field>
        <field name="arch" type="xml">
            <pivot string="Sample Observation Analysis">
                <field name="y_product_id" type="row"/>
                <field name="y_partner_id" type="row"/>
                <field name="y_state" type="col"/>
                <field name="y_lot_qty" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <!-- Calendar View -->
    <record id="view_sample_observation_calendar" model="ir.ui.view">
        <field name="name">sample.observation.calendar</field>
        <field name="model">sample.observation</field>
        <field name="arch" type="xml">
            <calendar string="Sample Observations" date_start="y_inspection_approved_date" color="y_state">
                <field name="name"/>
                <field name="y_product_id"/>
                <field name="y_partner_id"/>
                <field name="y_state"/>
            </calendar>
        </field>
    </record>

    <record id="sample_observation_view_search" model="ir.ui.view">
        <field name="name">sample.observation.view.search</field>
        <field name="model">sample.observation</field>
        <field name="arch" type="xml">
            <search string="Sample Observations">
                <field name="y_product_id" string="Product"/>
                <field name="y_partner_id" string="Partner"/>
                <field name="y_check_id" string="Check"/>
                <field name="y_po_ref" string="Purchase Order Reference"/>
                <field name="y_lot_id" string="Lot"/>
                <field name="y_grn_ref" string="GRN Reference"/>
                
                <filter string="Draft" name="draft" domain="[('y_state', '=', 'draft')]"/>
                <filter string="Processed" name="processed" domain="[('y_state', '=', 'process')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Product" name="group_by_product" context="{'group_by': 'y_product_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'y_partner_id'}"/>
                    <filter string="Test Type" name="group_by_test_type" context="{'group_by': 'y_test_type_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'y_state'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="view_sample_observation_line_tree" model="ir.ui.view">
        <field name="name">sample.observation.line.tree</field>
        <field name="model">sample.observation.line</field>
        <field name="arch" type="xml">
            <tree string="Sample Observation Lines" decoration-success="y_state == 'pass'" decoration-danger="y_state == 'fail'" decoration-info="y_state == 'to_do'" decoration-muted="y_state == 'cancelled'">
                <field name="name"/>
                <field name="y_sample_observation_id"/>
                <field name="y_title"/>
                <field name="y_measure"/>
                <field name="y_norm"/>
                <field name="y_norm_unit"/>
                <field name="y_tolerance_min"/>
                <field name="y_tolerance_max"/>
                <field name="y_remarks"/>
                <field name="y_state" widget="badge" decoration-success="y_state == 'pass'" decoration-info="y_state == 'to_do'" decoration-danger="y_state == 'fail'" decoration-muted="y_state == 'cancelled'"/>
            </tree>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_sample_observation_line_form" model="ir.ui.view">
        <field name="name">sample.observation.line.form</field>
        <field name="model">sample.observation.line</field>
        <field name="arch" type="xml">
            <form string="Sample Observation Line">
                <header>
                    <field name="y_state" widget="statusbar" statusbar_visible="to_do,pass,fail,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="y_sample_observation_id" readonly="1"/>
                            <field name="y_check_id" readonly="1"/>
                            <field name="y_product_id" readonly="1"/>
                            <field name="y_lot_id" readonly="1"/>
                            <field name="y_lot_qty" readonly="1"/>
                            <field name="y_po_ref" readonly="1"/>
                            <field name="y_title" readonly="1"/>
                            <field name="y_test_type" readonly="1"/>
                            <field name="y_sample_plan_id" readonly="1" />
                            <field name="y_remarks" readonly="1"/>
                        </group>
                        <group>
                            <field name="y_partner_id" readonly="1"/>
                            <field name="y_norm" readonly="1"/>
                            <field name="y_norm_unit" readonly="1" />
                            <field name="y_tolerance_min" readonly="1"/>
                            <field name="y_tolerance_max" readonly="1"/>
                            <field name="y_measure" />
                            <field name="y_pass_or_fail_boolean" invisible="1" widget="boolean_toggle"/>
                            <field name="y_grn_ref" readonly="1"/>
                            <field name="y_instrument_used" readonly="1"/>
                            <field name="y_inspection_approved_date" readonly="1"/>
                            <field name="y_sample_size_dimensional" invisible="y_test_type != 'measure'" readonly="1"/>
                            <field name="y_sample_size_visual" invisible="y_test_type == 'measure'" readonly="1"/>

                        </group>
                    </group>
                   
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Pivot View -->
    <record id="view_sample_observation_line_pivot" model="ir.ui.view">
        <field name="name">sample.observation.line.pivot</field>
        <field name="model">sample.observation.line</field>
        <field name="arch" type="xml">
            <pivot string="Sample Observation Line Analysis">
                <field name="name" type="row"/>
                <field name="y_state" type="col"/>
                <field name="y_measure" type="measure"/>
                <field name="y_norm" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <!-- Graph View -->
    <record id="view_sample_observation_line_graph" model="ir.ui.view">
        <field name="name">sample.observation.line.graph</field>
        <field name="model">sample.observation.line</field>
        <field name="arch" type="xml">
            <graph string="Sample Observation Line Analysis" type="bar">
                <field name="name"/>
                <field name="y_measure" type="measure"/>
                <field name="y_state" type="row"/>
            </graph>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_sample_observation_line" model="ir.actions.act_window">
        <field name="name">Sample Observation Lines</field>
        <field name="res_model">sample.observation.line</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sample observation
            </p>
        </field>
    </record>
    <record id="view_sample_observation_line_search" model="ir.ui.view">
        <field name="name">sample.observation.line.search</field>
        <field name="model">sample.observation.line</field>
        <field name="arch" type="xml">
            <search string="Sample Observation Line">
                <field name="name"  />
                <field name="y_sample_observation_id" string="Sample Observation"/>
                <field name="y_product_id" string="Product"/>
                <field name="y_partner_id" string="Partner"/>
                <field name="y_check_id" string="Check"/>
                <field name="y_lot_id" string="Lot"/>
                
                <field name="y_title" string="Title"/>
                <field name="y_test_type" string="Test Type"/>
                <field name="y_instrument_used" string="Instrument Used"/>
    
                <filter string="To Do" name="to_do" domain="[('y_state', '=', 'to_do')]"/>
                <filter string="Passed" name="passed" domain="[('y_state', '=', 'pass')]"/>
                <filter string="Failed" name="failed" domain="[('y_state', '=', 'fail')]"/>
                
                <filter string="Measurement Test" name="measurement_test" domain="[('y_test_type', '=', 'measure')]"/>
                <filter string="Visual Test" name="visual_test" domain="[('y_test_type', 'in', ['pass_fail','picture'])]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
    
                <group expand="0" string="Group By">
                    <filter string="Sample Observation" name="group_by_sample_observation" context="{'group_by': 'y_sample_observation_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'y_product_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'y_partner_id'}"/>
                    <filter string="Lot" name="group_by_lot" context="{'group_by': 'y_lot_id'}"/>
                    <filter string="Test Type" name="group_by_test_type" context="{'group_by': 'y_test_type'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'y_state'}"/>
                    <filter string="Instrument Used" name="group_by_instrument" context="{'group_by': 'y_instrument_used'}"/>
                </group>
            </search>
        </field>
    </record>
    
    
    <!-- Updated Action to Include New Views -->
    <record id="sample_observation_action" model="ir.actions.act_window">
        <field name="name">Sample Observation</field>
        <field name="res_model">sample.observation</field>
        <field name="view_mode">tree,kanban,form,pivot,calendar</field>
    </record>


  
    <menuitem
        id="sample_observation_menu"
        name="Sample Observations"
        parent="quality_control.menu_quality_configuration" action="sample_observation_action"
        sequence="60"/>

    <menuitem id="menu_sample_observation_line"
        name="Sample Observation Lines"
        action="action_sample_observation_line"
        parent="quality_control.menu_quality_configuration"
        sequence="65"/>


</odoo>
