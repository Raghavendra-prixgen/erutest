<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_from_inheirted" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='payment_term_id']" position="after">
                <field name="y_manager_sale_id"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Sale Documentation" name="sale_document"> 
                  <field name="y_cus_related_sale_doc_ids" invisible="1" />
                  <field name="y_customer_sale_doc_note_ids" readonly="state in ['cancel', 'sale']" domain="[('id','=',y_cus_related_sale_doc_ids)]" >
                    <!-- <form>
                      <header>
                        <field name="y_state" widget="statusbar"/>
                      </header>
                      <sheet>
                        <group>
                          <group>
                            <field name="y_name" />
                            <field name="y_sale_attachment_ids" widget="many2many_binary" />
                            <field name="y_order_notification" invisible="sale_notify_day == False"/>
                          </group>
                          <group>
                            <field name="y_sale_expiry_date" />
                            <field name="y_sale_notify_day" />
                          </group>
                          
                        </group>
                        
                      </sheet>
                      
                    </form> -->
                    <tree>
                      
                      <field name="y_name" />      
                      <field name="y_sale_expiry_date" />  
                      <field name="y_sale_day_expiry" />
                      <field name="y_order_notification" invisible="y_sale_notify_day == False"/>        
                      <field name="y_sale_notify_day" />  
                      <field name="y_sale_attachment_ids" widget="many2many_binary"/>
                      <field name="y_state" decoration-success="y_state == 'running'"
                      decoration-danger="y_state == 'expired'"
                      decoration-info="y_state == 'notify'"
                      widget="badge"/>  
                    </tree>
                  </field> 
                </page>
              </xpath>
        </field>
    </record>

    <record id="sale_document_notification_tree_view" model="ir.ui.view">
        <field name="name">sale.document.notification</field>
        <field name="model">sale.document.notification</field>
        <field name="arch" type="xml">
            <tree>
                <field name="y_sale_order_id" />
                <field name="y_name" />      
                <field name="y_sale_expiry_date" />
                <field name="y_sale_day_expiry" />  
                <field name="y_order_notification" invisible="y_sale_notify_day == False"/>
                <field name="y_sale_notify_day" />      
                <field name="y_sale_attachment_ids" widget="many2many_binary" />
                <field name="y_state" decoration-success="y_state == 'running'"
                decoration-danger="y_state == 'expired'"
                decoration-info="y_state == 'notify'"
                widget="badge"/>  
            </tree>
        </field>
    </record>

    <record id="document_notification_sale_from_view" model="ir.ui.view">
        <field name="name">sale.document.notification</field>
        <field name="model">sale.document.notification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="y_state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="y_name" />
                            <field name="y_sale_attachment_ids" widget="many2many_binary" />
                            <field name="y_order_notification" invisible="y_sale_notify_day == False"/>
                        </group>
                        <group>
                            <field name="y_sale_expiry_date" />
                            <field name="y_sale_notify_day"/>
                        </group>
                    </group> 
                </sheet>
            </form>
        </field>
    </record>
    <!-- <record id="action_manage_document_notifications" model="ir.actions.server">
      <field name="name">Manage Document Notifications</field>
      <field name="model_id" ref="model_sale_order"/>
      <field name="binding_model_id" ref="model_sale_order"/>
      <field name="state">code</field>
      <field name="code">
        for record in records:
            action = record.update_res()
      </field>
  </record> -->
    <record id="action_sale_document_notify" model="ir.actions.act_window">
		<field name="name">Documents Notification</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">sale.document.notification</field>
		<field name="view_mode">tree,form</field>
    <field name="view_id" ref="odoo_e_32.sale_document_notification_tree_view"/>
	</record>

  <menuitem
        id="menu_sale_document_note"
        name="Sale Documents"
        action="action_sale_document_notify" 
        parent="sale.menu_sale_config"
        sequence="110"/>

</odoo>