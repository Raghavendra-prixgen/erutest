                                  <span><div class="row"><div style="width:37%;">IFSC Code</div> <div style="width:3%;">:</div><div style="width:60%;"><t t-if="doc.company_id.partner_id.bank_ids[0].bank_id.bic"><span t-field="doc.company_id.partner_id.bank_ids[0].bank_id.bic"></span></t></div></div></span>
