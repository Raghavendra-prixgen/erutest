<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data>
        <template id="external_layout_for_commercial">

            <div class="header" style="display: flex; width: 100%;font-family: Arial;">
                <table class="table-sm m-0 p-0 table-condensed table-bordered"
                style="border:1px solid black;width:100%;">
                        <tr>
                            <td style="border:1px solid black;">
                                <div class="row">
                                    <div class="col-2 text-left">
                                        <img t-if="doc.company_id.parent_id.logo"
                                        t-att-src="image_data_uri(doc.company_id.parent_id.logo)"
                                        style="height:120px;width:136px;margin-top:6px;margin-left:15px;"
                                        alt="Logo" />
                                  
        
                                    </div>
                                    <div class="col-8 text-center" style="font-size:13px;margin-top:8px;">
        
        
                                      
                                        <t class="text-center">
        
                                            <b>
                                                <span style="font-size:17px;font-family: Century Gothic;"
                                                    t-field="doc.company_id.parent_id.name" />
                                            </b>
                                            <br />
                                               
                                             <b>
                                        <span style="font-size:11px;">Regd Office:</span>
                                     </b>
                                        <span style="font-size:11px;font-family: Century Gothic;"
                                             t-field="doc.company_id.parent_id.street" /><br/>
                                        <span style="font-size:11px;font-family: Century Gothic;"
                                             t-field="doc.company_id.parent_id.street2" /><br/>
                                        <span style="font-size:11px;font-family: Century Gothic;"
                                            t-field="doc.company_id.parent_id.city" />,
                                        <span style="font-size:11px;font-family: Century Gothic;"
                                            t-field="doc.company_id.parent_id.state_id" />-
                                        <span style="font-size:11px;font-family: Century Gothic;"
                                            t-field="doc.company_id.parent_id.zip" />
                                        <br />
                                       
                                        <b><span style="font-size:11px;font-family: Century Gothic;">GSTIN :</span></b>
                                   
                                    <span style="font-size:11px;font-family: Century Gothic;" t-if="doc.company_id.parent_id.vat"
                                          t-field="doc.company_id.parent_id.vat" />
                                   
                                     
                                    <b><span style="font-size:11px;font-family: Century Gothic;">PAN :</span></b>
                                    
                                    <span style="font-size:11px;font-family: Century Gothic;" t-if="doc.company_id.parent_id.partner_id.l10n_in_pan"
                                    t-field="doc.company_id.parent_id.partner_id.l10n_in_pan" /> 
                                       
                                                                             

                                            
                                                <b><span style="font-size:11px;font-family: Century Gothic;">
                                            CIN :</span></b>
        
                                            <span style="font-size:11px;font-family: Century Gothic;" t-if="doc.company_id.parent_id.company_registry"
                                                        t-field="doc.company_id.parent_id.company_registry"
                                                         />
                                            
                                                <!-- </t> -->
                                                <br/>
                                                
                                    
                                            
                                     <b><span style="font-size:11px;font-family: Century Gothic;">Mail Id :</span></b>
                                        
                                     <span style="font-size:11px;font-family: Century Gothic;" t-if="doc.company_id.parent_id.email"
                                         t-field="doc.company_id.parent_id.email" />
                                        
                                     <b><span style="font-size:11px;font-family: Century Gothic;">WebPage :</span></b>
                                    
                                    <span style="font-size:11px;font-family: Century Gothic;" t-if="doc.company_id.parent_id.website"
                                         t-field="doc.company_id.parent_id.website" />
                                       
                                      <br/>
                                    <b><span style="font-size:11px;font-family: Century Gothic;">Contact Number :</span></b>
                                    
                                    <span style="font-size:11px;font-family: Century Gothic;">
                                    <t t-if="doc.company_id.parent_id.mobile">
                                        <span t-field="doc.company_id.parent_id.mobile" />
                                        <br />
                                    </t>
                                    </span>
                                </t>
                            </div>
                            <div class="col-2"></div>
                            </div>
                         </td>
                    </tr>
                </table>    
            
                <table class="table m-0 p-0 table-borderless" style="font-size: 16px; width: 100%;border-left: 1px solid black; border-right: 1px solid black;">

                    <tr style="width:100%">
                        <td style="width:50%;text-align: center;padding-top:5px;font-family: Century Gothic;">

                            <strong>Commercial Invoice</strong>
                        </td>
                    </tr>

                </table>

                <table style="font-size: 11px; width: 100%;font-family: Century Gothic;">
                    <tr>
                        <td style="width: 50%; border-bottom:none;border-right: 1px solid black;border-left: 1px solid black;border-top: 1px solid black;padding-left:3px">
                            <span><div class="row"><div style="width:27%;padding-top:5px;"><strong>Bill To </strong></div><div style="width:3%;padding-top:5px;">:</div><div style="width:70%;padding-top:5px;"><span t-field="doc.partner_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Address </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_id.street"></span>
                            <span style="width:70%;"><span t-field="doc.partner_id.street2"></span></span>
                            <span style="width:70%;"><span t-field="doc.partner_id.city"></span></span>
                            <span style="width:70%;"><span t-field="doc.partner_id.zip"></span></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong> State </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_id.state_id.name"></span></div></div> </span>
                            <span><div class="row"><div style="width:27%;"><strong>State Code </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_id.state_id.code"></span></div></div> </span>
                            <span><div class="row"><div style="width:27%;"><strong>Country </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_id.country_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong> Email </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_id.email"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong> Contact Person </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_id.name"></span></div></div></span>

                        </td> 
                        <td style="width: 50%;border-bottom:none;padding-left:3px;font-family: Century Gothic;border-right: 1px solid black;border-top: 1px solid black;">
                            <span><div class="row"><div style="width:27%;padding-top:5px;"><strong>Ship To</strong></div><div style="width:3%;padding-top:5px;">:</div><div style="width:70%;padding-top:5px;"><span t-field="doc.partner_shipping_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Address</strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_shipping_id.street"></span>
                            <span style="width:70%;"><span t-field="doc.partner_shipping_id.street2"></span></span>
                            <span style="width:70%;"><span t-field="doc.partner_shipping_id.city"></span></span>
                            <span style="width:70%;"><span t-field="doc.partner_shipping_id.zip"></span></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>State </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_shipping_id.state_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>State Code </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_shipping_id.state_id.code"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Country </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_shipping_id.country_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Email </strong> </div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_shipping_id.email"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Contact Person </strong> </div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.partner_shipping_id.name"></span></div></div></span>

                        </td>
                    </tr>
                </table>
                <table style="font-size: 11px; width: 100%; border: 1px solid black;">
                    <tr>
                        <td style="width: 50%; border-bottom:none;border-right: 1px solid black;padding-left:3px;font-family: Century Gothic;">
                            <div class="row">
                                <div style="width: 27%;padding-top:5px;"><span><strong>Invoice No </strong></span></div><div style="width:3%;padding-top:5px;">:</div>
                                <div style="width: 70%;padding-top:5px;"><span t-field="doc.name"></span></div>
                            </div>
                            <div class="row">
                                <div style="width: 27%;"><span><strong>Invoice Date</strong> </span></div><div style="width:3%;">:</div>
                                <div style="width: 70%;"><span t-field="doc.invoice_date"  t-options="{'widget': 'date'}"></span></div>
                            </div>
                            <div class="row">
                                <div style="width: 27%;"><span><strong>SO Number &amp; Date </strong></span></div><div style="width:3%;">:</div>
                                <div style="width: 70%;"><span t-esc="doc.sale_order()"/> &amp;
                                <span t-esc="doc.sale_order_date()"/></div>
                            </div>
                            <div class="row">
                                <div style="width: 27%;"><span><strong>Buyer order No &amp; Date </strong></span></div><div style="width:3%;">:</div>
                                <div style="width: 70%;"><span t-esc="doc.sale_order_po_ref()"/> &amp;
                                <span t-esc="doc.sale_order_po_date()"/></div>
                            </div>
                            <div class="row">
                                <div style="width: 27%;"><span><strong>Country of origin </strong></span></div><div style="width:3%;">:</div>
                                <div style="width: 70%;"><span t-field="doc.y_country_orgin_goods_id"></span></div>
                            </div>
                        </td>
                        <td style="width: 50%;padding-left:3px;border-bottom:none;font-family: Century Gothic;">
                            <div class="row">
                                <b><div style="width: 100%;padding-top:5px;"><span>Export Reference No. &amp; Date </span></div></b>
                              <!--   <div style="width:3%;padding-top:5px;">:</div>
                                <div style="width: 70%;padding-top:5px;"><span t-esc="doc.y_export_ref_no"/>  &amp;
                                <span t-esc="doc.y_export_ref_date"/></div> -->
                            </div>
                            <div class="row">
                                <div style="width: 27%;"><span><strong>IEC No </strong></span></div><div style="width:3%;">:</div>
                                <div style="width: 70%;"><span t-field="doc.company_id.parent_id.partner_id.y_iec_no"></span></div>
                            </div>
                            <div class="row">
                                <div style="width: 27%;"><span><strong>IEC Date </strong></span></div><div style="width:3%;">:</div>
                                <div style="width: 70%;"><span t-field="doc.company_id.parent_id.partner_id.y_iec_date" t-options="{'widget': 'date'}"></span></div>
                            </div>
                        </td>
                    </tr>
                </table>

                <table class="table m-0 p-0 table-borderless" style="font-size: 11px;; width: 100%;font-family: Century Gothic;">
                    <tr>
                        <td style="width: 50%; border-top:none;border-top:none;border-right: 1px solid black;border-left: 1px solid black;padding-left:3px;font-family: Century Gothic;">
                            <span><div class="row"><div style="width:27%;padding-top:5px;"><strong>Ship From </strong></div><div style="width:3%;padding-top:5px;">:</div><div style="width:70%;padding-top:5px;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.company_id.parent_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Address </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.street"></span>
                            <span style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.street2"></span></span>
                            <span style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.city"></span></span>
                            <span style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.zip"></span></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>State </strong></div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.state_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>State Code</strong> </div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.state_id.code"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Country</strong> </div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.country_id.name"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>GSTIN</strong> </div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.vat"></span></div></div></span>
                            <span><div class="row"><div style="width:27%;"><strong>Contact Person</strong> </div><div style="width:3%;">:</div><div style="width:70%;"><span t-field="doc.invoice_line_ids.sale_line_ids.order_id.warehouse_id.partner_id.phone"></span></div></div></span>
                        </td>
                       
                        <td style="width: 50%;border-bottom:none;border-top:none;border-right: 1px solid black;padding-left:3px;font-family: Century Gothic;"> 
                            <span><div class="row"><div style="width:47%;padding-top:5px;"><strong>Country of Destination</strong></div><div style="width:3%;padding-top:5px;">:</div><div style="width:50%;padding-top:5px;"><span t-field="doc.y_country_final_destination_id"></span></div></div> </span>
                            <span><div class="row"><div style="width:47%;"><strong>Pre carriage by</strong></div><div style="width:3%;">:</div><div style="width:50%;"><span t-field="doc.y_pre_carriage"></span></div></div></span>
                            <span><div class="row"><div style="width:47%;"><strong>Place of receipt by Pre-Carrier</strong></div><div style="width:3%;">:</div><div style="width:50%;"><span t-field="doc.y_final_destination_id"></span></div></div></span>
                            <span><div class="row"><div style="width:47%;"><strong>Vessel No / Flight no</strong></div><div style="width:3%;">:</div><div style="width:50%;"><span t-field="doc.y_vessel_number"></span></div></div></span>
                            <span><div class="row"><div style="width:47%;"><strong>Container No</strong></div><div style="width:3%;">:</div><div style="width:50%;"><span t-field="doc.y_voyage_no"></span></div></div> </span>
                            <span><div class="row"><div style="width:47%;"><strong>Port of Loading</strong></div><div style="width:3%;">:</div><div style="width:50%;"><span t-field="doc.y_port_loading_id"></span></div></div></span>
                            <span><div class="row"><div style="width:47%;"><strong>Port of Discharge</strong></div><div style="width:3%;">:</div><div style="width:50%;"><span t-field="doc.y_port_discharge_id"></span></div></div></span>
                        </td>
                    </tr>
                </table>

                <table style="font-size: 11px; width: 100%; border-top:none;border: 1px solid black;font-size:11px;">
                    <tr>
                        <td style="width: 50%;padding-left:3px;font-family: Century Gothic;">
                            <br />
                            <strong>Terms of Delivery &amp; Payment : </strong>
                            <span t-field="doc.invoice_incoterm_id"/> &amp; 
                            <span t-field="doc.invoice_payment_term_id"/> <br />
                            <br />
                        </td>
                    </tr>
                </table>
            </div>

            <div class="article o_report_layout_standard" t-att-data-oe-model="doc and doc._name" t-att-data-oe-id="doc and doc.id" t-att-data-oe-lang="doc and doc.env.context.get('lang')">
                <t t-call="web.address_layout"/>
                <t t-raw="0"/>
            </div>

            <div class="footer o_standard_footer">
                <div class="col-12" style="text-align:center;padding:1px;margin-top:none !important;font-color:gray;border-top:1px solid black;">
                    <p style="color:black;font-size:11px;text-align:center;" class="text-muted">
                    Page:
                    <span class="page"/>
                    of
                    <span class="topage"/></p>
                </div>
            </div>
