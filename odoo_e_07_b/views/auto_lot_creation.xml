<odoo>
  <data>

    <record id="view_auto_lot_serial_number_inherit" model="ir.ui.view">
      <field name="name">stock.move.inherit.auto</field>
      <field name="model">stock.move</field>
      <field name="inherit_id" ref="stock.view_stock_move_operations"/>
      <field name="arch" type="xml">
        <field name="product_uom" position="after">
          <button name="action_generate_serial" type="object" string="Generate Lot" class="oe_highlight" title="Generate Lot"/>
        </field>
      </field>
    </record>

    <record id="view_stock_move_line_operation_tree_inherit_readonly" model="ir.ui.view">
      <field name="name">stock.move.inherit.readonly</field>
      <field name="model">stock.move.line</field>
      <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
      <field name="arch" type="xml">
        <field name="lot_id" position="attributes">
          <attribute name="readonly">package_level_id != False and parent.picking_type_entire_packs != False and picking_code in ['incoming']</attribute>
        </field>
      </field>
    </record> 


  </data>
</odoo>
