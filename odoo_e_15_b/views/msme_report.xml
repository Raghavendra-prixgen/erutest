<odoo>

	<record id="india_msme_report_tree_view" model="ir.ui.view">
      <field name="name">india.msme.account.move</field>
      <field name="model">account.move</field>
      <field name="arch" type="xml">
        <tree create="false">
          
          <field name="partner_id" string="Vendor Name"/>
          <field name="name" />
          
                    <field name="y_po" column_invisible="True"/>

          <field name="y_is_micro_yes_or_no" column_invisible="True"/>
          <field name="y_is_micro_or_small_enterprise" column_invisible="True"/>
          <field name="y_registration_number" string="MSME / Udyam Reg No"/>
          <field name="date" readonly="1" string="Acceptance Date"/>
          <field name="amount_total" string="Vendor Bill Amount"/>
          <field name="invoice_payment_term_id" string="PO Payment Terms (days)"/>
          <field name="y_amount_paid_tilldate" string="Amount Paid Till date"/>
          <field name="y_payed_date" string="Paid date"/>
          <field name="amount_residual" string="Balance"/>
          <field name="y_days_from"/>
          <!-- <field name="y_is_aggrement_msme" column_invisible="True"/>
          <field name="y_is_aggrement_msme_yes_or_no"/>
          <field name="y_day_15_limit"/>
          <field name="y_date_as_po_agreed"/>
          <field name="y_date_as_per_agreed_terms"/>
          <field name="y_date_of_payment"/>
          <field name="y_delay_by_no_months"/>
          <field name="y_monthly_interest_rate" widget="percentage"/>
          <field name="y_interedted_amount"/> -->
        </tree>
      </field>
    </record>

    <record id="india_msme_wiz_view_form" model="ir.ui.view">
      <field name="name">india.msme.wiz.view.form</field>
      <field name="model">india.msme.wiz</field>
      <field name="arch" type="xml">
        <form string="MSME Report">
          <sheet>
            <group>
              <group>
                <field name="y_open_date" required="1"/>
                <field name="y_close_date" required="1"/> 
              </group>
            </group>
            <footer>
              <button name="action_open_report" type="object" class="oe_highlight" string="Execute"/>
            </footer>
          </sheet>
        </form>
      </field>
    </record>


    <record id="view_move_form_inherit_account_move_msme" model="ir.ui.view">
      <field name="name">account.move.view.form.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <xpath expr="//group/group//field[@name='date']" position="after">

            <field name="y_account_date_tooltip" nolabel="0" string="" invisible="move_type not in ['in_invoice'] and partner_id.y_ms"></field>

        </xpath>
      </field>
     </record>

	
	<record id="msme_india_report" model="ir.actions.act_window">
      <field name="name">MSME Report</field>
      <field name="res_model">india.msme.wiz</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

    <menuitem id="msme_india_menu"
                    name="MSME Report"
                    parent="account.menu_finance_reports"
                    />

        <menuitem id="msme_india_menu_child"
                    name="MSME Report"
                    action="msme_india_report"
                    parent="msme_india_menu"
                   />


                  

   <!--  <menuitem id="msme_india_menu" name="MSME Report" parent="account.menu_finance_reports" action="msme_india_report"/> -->
</odoo>
