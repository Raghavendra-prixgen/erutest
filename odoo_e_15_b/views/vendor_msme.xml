<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="custom_contact_local" model="ir.ui.view">
            <field name="name">Custom Contact</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <div
                        class="alert alert-warning mb-0" role="alert"
                        invisible="not warning_bool">
                        Assign Fiscal position to display the taxes <b></b>.<br/>   
                    </div>
                </xpath>
                <field name="name" position="after">
                <field name="warning_bool" invisible="1"/>    
                </field>
                <notebook position="inside">
                    <page string="MSME " name="msme_fields">
                        <group>
                            <group>
                                <field name="y_msme_registered" widget="boolean_toggle"/>
                                <field name="y_registration_number" invisible="not y_msme_registered" required="y_msme_registered == True"/>
                                <field name="y_msme_reg_date" invisible="not y_msme_registered" required="y_msme_registered == True"/>
                                <field name="y_validity_period" invisible="not y_msme_registered"/>
                                <field name="y_expiry_date" invisible="not y_msme_registered"/>
                                <field name="y_validity_days" invisible="not y_msme_registered"/>
                                <field name="y_is_aggrement_msme" widget="boolean_toggle"  invisible="1"/>
                                <field name="y_monthly_interest_rate" widget="percentage" invisible="1"/>
                            </group>
                            <group>
                               
                                <field name="y_is_micro_or_small_enterprise" invisible="not y_msme_registered"/>
                                <field name="y_msme_small"   invisible="not y_msme_registered"/>
                                <field name="y_msme_medium"   invisible="not y_msme_registered"/>
                                <field name="y_type_of_business" required="y_msme_registered == True"/>
                                
                            </group>
                        </group>                 
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>