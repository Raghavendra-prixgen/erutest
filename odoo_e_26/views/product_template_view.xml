<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_inherited" model="ir.ui.view">
        <field name="name">product.template.inherited</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='y_purchase_tol_reqd']" position="after">
                <field name="y_doc_type_ids" widget="many2many_tags" required="purchase_ok == True"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_inherited" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='products']//field[@name='order_line']/tree/field[@name='product_id']" position="replace">
                <field
                    name="product_id"
                    readonly="state in ('purchase', 'to approve', 'done', 'cancel')"
                    required="not display_type"
                    width="35%"
                    context="{'partner_id':parent.partner_id, 'quantity':product_qty, 'company_id': parent.company_id}"
                    force_save="1" domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" />
            </xpath>
        </field>
    </record>
</odoo>
