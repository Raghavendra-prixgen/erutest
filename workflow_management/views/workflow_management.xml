<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Entries -->
    <record id="global_approval_entry_tree_view" model="ir.ui.view">
        <field name="name">global.approval.entry.tree</field>
        <field name="model">global.approval.entry</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="write_date"/>
            </tree>
        </field>
    </record>

    <record id="global_approval_entry_form_view" model="ir.ui.view">
        <field name="name">global.approval.entry.form</field>
        <field name="model">global.approval.entry</field>
        <field name="arch" type="xml">
            <form string="global Approval Entry">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="rule_id"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="res_id"/>
                            <field name="reference" widget="reference" string="Record"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="global_approval_entry_search_view" model="ir.ui.view">
        <field name="name">global.approval.entry.search</field>
        <field name="model">global.approval.entry</field>
        <field name="arch" type="xml">
            <search string="Approval Entries">
                <field name="name"/>
                <field name="res_id"/>
                <field name="user_id"/>
                <field name="rule_id" invisible="1"/>
                <separator/>
                <filter string="My entries" name="my_entries" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter string="Approved" name="approved" domain="[('approved','=', True)]"/>
                <filter string="Rejected" name="rejected" domain="[('user_id','=', False)]"/>
                <group>
                    <filter string="Model" name="model" domain="[]" context="{'group_by':'model'}"/>
                    <filter string="Method" name="model" domain="[]" context="{'group_by':'method'}"/>
                    <filter string="Action" name="model" domain="[]" context="{'group_by':'action_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="global_approval_entry_action" model="ir.actions.act_window">
        <field name="name">global Approval Entries</field>
        <field name="res_model">global.approval.entry</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_global_approval_entry" name="global Approval Entries" sequence="11" action="global_approval_entry_action" parent="base.next_id_2" groups="base.group_system"/>
    <!-- Approval Rules -->
    <record id="global_approval_rule_tree_view" model="ir.ui.view">
        <field name="name">global.approval.tree</field>
        <field name="model">global.approval.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="approver_ids"/>
                <field name="approval_group_id"/>
                <field name="message"/>
                <field name="model_id"/>
                <field name="model_id_stored" column_invisible="0"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="global_approval_rule_kanban_view" model="ir.ui.view">
        <field name="name">global.approval.kanban</field>
        <field name="model">global.approval.rule</field>
        <field name="arch" type="xml">
            <kanban quick_create_view="web_global.global_approval_rule_form_view_quick_create" highlight_color="kanban_color" class="o-global-approval-rule-kanban">
                <field name="can_validate"/>
                <field name="kanban_color"/>
                <field name="exclusive_user"/>
                <templates>
                    <t t-name="card">
                        <div class="row justify-content-between py-1">
                            <div class="col fs-4 text-truncate" t-att-title="record.message.raw_value">
                                <field t-if="record.message.raw_value" name="message"/>
                                <span t-else="" class="text-muted">Step</span>
                            </div>
                            <div t-if="record.exclusive_user.raw_value" class="col-2"><i role="img" class="fa fa-user-times" title="Exclusive approval"/></div>
                        </div>
                        <div class="text-truncate" t-att-title="record.approval_group_id.value">
                            <field name="approval_group_id"/>
                        </div>
                        <footer class="justify-content-between py-1">
                            <a t-if="record.can_validate.raw_value" role="button" class="btn btn-link px-0 py-0" name="open_delegate_action" type="object" string="Delegate"/>
                            <field t-if="record.approver_ids.raw_value.length" class="justify-content-end align-items-center ms-auto" readonly="1" name="approver_ids" widget="many2many_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="global_approval_rule_form_view_quick_create" model="ir.ui.view">
        <field name="name">global.approval.form.quick_create</field>
        <field name="model">global.approval.rule</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="approver_ids" required="not approval_group_id" placeholder="Select users..." widget="many2many_tags"/>
                    <field name="approval_group_id" required= "not approver_ids" placeholder="Select a group..."/>
                    <field name="users_to_notify" placeholder="Select users..." widget="many2many_tags"/>
                    <field name="exclusive_user" widget="boolean_toggle"/>
                </group>
                <field name="model_id" invisible="1"/>
                <field name="action_id" invisible="1"/>
                <field name="method" invisible="1"/>
            </form>
        </field>
    </record>

    <record id="global_approval_rule_form_view" model="ir.ui.view">
        <field name="name">global.approval.form</field>
        <field name="model">global.approval.rule</field>
        <field name="arch" type="xml">
            <form string="global Approval Rule">
                <header>
                    <field name="notification_order" widget="statusbar" options="{'clickable': '1'}"/>
                    <button name="open_delegate_action" type="object" string="Delegate" class="btn btn-primary" invisible="not can_validate"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button class="oe_stat_button" type="action" name="%(global_approval_entry_action)d"
                                icon="fa-thumbs-up"
                                context="{'search_default_rule_id':id, 'default_chart_id': id}">
                            <field string="Entries" name="entries_count" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="message"/>
                            <field name="can_validate" invisible="1"/>
                            <field name="approver_ids" required="not approval_group_id" placeholder="Select users..." widget="many2many_tags"/>
                            <field name="approval_group_id" required= "not approver_ids" placeholder="Select group"/>
                            <field name="exclusive_user" widget="boolean_toggle"/>
                            <field name="model_id"  required="1" readonly="context.get('global')" groups="base.group_no_one"/>
                            <field name="action_id" required="not method" readonly="method or context.get('global')"  groups="base.group_no_one"/>
                            <field name="method" required="not action_id" readonly="action_id or context.get('global')"  groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="users_to_notify" placeholder="Select users..." widget="many2many_tags"/>
                            <field name="model_id" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="domain" widget="domain" options="{'foldable': True,'model': 'model_name'}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="global_approval_rule_button_configuration_search_view" model="ir.ui.view">
        <field name="name">global.approval.search</field>
        <field name="model">global.approval.rule</field>
        <field name="arch" type="xml">
            <search string="Approval Rules">
                <field name="name"/>
                <field name="approval_group_id"/>
                <field name="approver_ids"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <filter string="Step" name="notification_order" domain="[]" context="{'group_by':'notification_order'}"/>
            </search>
        </field>
    </record>

    <record id="global_approval_rule_search_view" model="ir.ui.view">
        <field name="name">global.approval.search</field>
        <field name="model">global.approval.rule</field>
        <field name="inherit_id" ref="global_approval_rule_button_configuration_search_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
            </filter>
            <filter name="notification_order" position="replace">
                <filter string="Model" name="model_id_stored" domain="[]" context="{'group_by':'model_id_stored'}"/>
                <!-- <filter string="Model" name="model" domain="[]" context="{'group_by':'model_id'}"/> -->
                <filter string="Method" name="method" domain="[]" context="{'group_by':'method'}"/>
                <filter string="Action" name="action" domain="[]" context="{'group_by':'action_id'}"/>
            </filter>
        </field>
    </record>


    <record id="global_approval_rule_delegate_approvers" model="ir.ui.view">
        <field name="name">global.approval.rule.delegate.form</field>
        <field name="model">global.approval.rule.delegate</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <label for="approver_ids">Approvers</label>
                    <div>
                        <field name="approver_ids" widget="many2many_tags"/>
                        <div class="d-flex mt-2">
                            <label for="date_to" />
                            <field name="date_to" class="d-inline ms-2" placeholder="Forever"/>
                        </div>
                    </div>
                    <field name="users_to_notify" widget="many2many_tags" />
                </group>
                <footer>
                    <button special="save" string="Apply" class="btn btn-primary" />
                    <button special="cancel" string="Discard" class="btn btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_global_model_kanban" model="ir.ui.view">
            <field name="name">global.model.kanban</field>
            <field name="model">global.model</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="message"/>
                    <field name="model_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-8">
                                        <strong><field name="message"/></strong>
                                    </div>
                                    
                                </div>
                                <div>
                                    <strong>Model: </strong><t t-out="record.model_id.value"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>



    <record id="view_global_model_form" model="ir.ui.view">
        <field name="name">global.model.form</field>
        <field name="model">global.model</field>
        <field name="arch" type="xml">
          <form string="Global Model" >
            <sheet>
                <group>
                    <group>
                        <field name="message" />
                        <field name="model_id" />
                        <field name="maximum_approval_limit"/>
                       
                    </group>
                <group>
                </group>
                </group>
                    <notebook>
                        <page string="Global Model Approval Rule" name="global_approval_rule_ids" >
                            <field name="global_approval_rule_ids" widget="section_and_note_one2many" >
                                <tree string="Global Model Approval Rule">
                                   
                                    <field name="approver_ids" required="not approval_group_id" placeholder="Select users..." widget="many2many_tags"/>
                                    <field name="approval_group_id" column_invisible="1"/>

                                    <field name="model_name" column_invisible="1"/>
                                    <field name="domain" widget="domain" options="{'foldable': True,'model': 'model_name'}"/>
                                    <field name="action_id" column_invisible="1"/>
                                    <field name="method" required="not action_id" readonly="action_id or context.get('global')"  groups="base.group_no_one"/>
                                    <field name="users_to_notify" placeholder="Select users..." widget="many2many_tags"/>
                                   

                                </tree>
                            </field>
                        </page>

                    
                        
                    </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids" widget="mail_followers"/>
                <field name="message_ids" widget="mail_thread"/>
                <field name="activity_ids"/>
            </div> 	
          </form>
        </field>
      </record>




    <record id="global_model_rule_tree_view" model="ir.ui.view">
        <field name="name">global.model.tree</field>
        <field name="model">global.model</field>
        <field name="arch" type="xml">
            <tree>
                <field name="message"/>
                <field name="model_id"/>
               
            </tree>
        </field>
    </record>

    <record id="global_approval_rule_action" model="ir.actions.act_window">
        <field name="name">Global Approval Rules</field>
        <field name="res_model">global.approval.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False, 'search_view_ref': 'web_global.global_approval_rule_search_view'}</field>
    </record>

    <record id="global_approval_model_actions" model="ir.actions.act_window">
        <field name="name">Global Approval Models</field>
        <field name="res_model">global.model</field>
        <field name="view_mode">kanban,tree,form</field>
        
    </record>

    <menuitem id="menu_global_approval_rule" name="Global Approval Rules" sequence="10" action="global_approval_rule_action" parent="base.next_id_2" groups="base.group_system"/>

     <menuitem id="menu_global_model" name="Global Approval Models" sequence="10" action="global_approval_model_actions" parent="base.next_id_2" groups="base.group_system"/>

</odoo>
