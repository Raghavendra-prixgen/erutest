<odoo>

    
    <record id="view_purchase_short_close_wizard_form_service_qty" model="ir.ui.view">
        <field name="name">purchase.short.close.wizard.form.service.qty</field>
        <field name="model">purchase.short.close.wizard</field>
        <field name="inherit_id" ref="odoo_e_27_b.view_purchase_short_close_wizard_form"/>
        <field name="arch" type="xml">

          

            <!-- Show the line-wise resolved Received Qty instead -->
            <xpath expr="//tree/field[@name='qty_received']" position="after">
                <field name="qty_invoiced" readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>
