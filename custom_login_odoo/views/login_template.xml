<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hide - or - from OAuth providers template -->
    <template id="hide_or_separator" inherit_id="auth_oauth.providers" name="Hide OR Separator">
        <xpath expr="//em" position="replace"/>
    </template>

    <!-- Hide email/password fields from main login -->
    <template id="web_login_custom" inherit_id="web.login" name="Custom Login - Hide Email/Password">

        <!-- Hide Email field -->
        <xpath expr="//div[hasclass('field-login')]" position="replace"/>

        <!-- Hide Password field -->
        <xpath expr="//div[hasclass('mb-3')][.//input[@id='password']]" position="replace"/>

        <!-- Hide error/message alerts -->
        <xpath expr="//p[hasclass('alert-danger')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//p[hasclass('alert-success')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide Log in button -->
        <xpath expr="//button[@type='submit'][hasclass('btn-primary')]" position="replace"/>

        <!-- Hide debug superuser block -->
        <xpath expr="//t[@t-if='debug']" position="replace"/>

        <!-- Hide redirect hidden input -->
        <xpath expr="//input[@name='redirect']" position="replace"/>

    </template>

</odoo>
