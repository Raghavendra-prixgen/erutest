<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AWS Configuration Parameters -->
        <record id="aws_access_key_id" model="ir.config_parameter">
            <field name="key">aws.access_key_id</field>
            <field name="value">YOUR_AWS_ACCESS_KEY_ID</field>
        </record>
        
        <record id="aws_secret_access_key" model="ir.config_parameter">
            <field name="key">aws.secret_access_key</field>
            <field name="value">YOUR_AWS_SECRET_ACCESS_KEY</field>
        </record>
        
        <record id="aws_region" model="ir.config_parameter">
            <field name="key">aws.region</field>
            <field name="value">us-east-1</field>
        </record>
        
        <record id="aws_s3_bucket" model="ir.config_parameter">
            <field name="key">aws.s3_bucket</field>
            <field name="value">your-odoo-attachments-bucket</field>
        </record>
    </data>
</odoo>