        <!-- Inherit attachment form view -->
        <record id="view_attachment_form_s3" model="ir.ui.view">
            <field name="name">ir.attachment.form.s3</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_form"/>
            <field name="arch" type="xml">
                <field name="url" position="after">
                    <field name="is_s3_stored" readonly="1"/>
                    <field name="s3_url" invisible="1"/>
                    <field name="s3_key" invisible="1" />
                    <button name="action_retry_s3_upload" type="object" 
                            class="oe_stat_button" icon="fa-cloud-upload"
                            >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Retry S3</span>
                            <span class="o_stat_text">Upload</span>
                        </div>
                    </button>
                </field>





               
            </field>
        </record>


     <record id="action_attachment_to_s3_pdf_integration" model="ir.actions.server">
        <field name="name">Update Atachment to S3</field>
        <field name="model_id" ref="s3_pdf_integration.model_ir_attachment" />
        <field name="binding_model_id" ref="s3_pdf_integration.model_ir_attachment" />
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.action_retry_s3_upload()
        </field>
    </record>




    </data>
