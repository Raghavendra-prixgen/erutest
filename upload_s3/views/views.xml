        <record id="res_config_settings_view_form_design_url" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.url.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='res_config_dev_tool']" position="before">
              
                    <div id="sap_database_api_settings">
                    <h2>S3 integration settings</h2>
               
                    <div class="row mt16 o_settings_container" name="s3_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="sap_database" title="S3 integration settings">
                        <div class="o_setting_right_pane" id="s3_container_api_settings">
                            <div>
                                <label for="s3_region"/>
                            </div>
                            <div>
                                <field name = "s3_region"/>
                            </div>

                            <div>
                                <label for="s3_bucket"/>
                            </div>
                            <div>
                                <field name = "s3_bucket"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </field>
    </record>


    

