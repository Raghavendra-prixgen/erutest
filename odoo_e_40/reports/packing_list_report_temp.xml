                                        <td colspan="11" style="border:1px solid black;text-align:left;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:1px solid black;font-family: Century Gothic;">
                                            <span><b>Kit Product: </b></span>
                                            <span t-esc="line.y_kit_product.split('-')[0].strip()" /><strong> - </strong><strong><span t-esc="o.get_kit_product_quantity(line.y_kit_product)" /></strong> <strong>No's</strong>
                                        </td>
                                    </tr>
