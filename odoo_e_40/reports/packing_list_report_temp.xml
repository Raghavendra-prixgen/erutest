                                        <t t-set="sl" t-value="sl+1" />
                                    </td>
                                    <td colspan="2" style="border:1px solid black;text-align:left;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:1px solid black;font-family: Century Gothic;">
                                        <span t-esc="line.y_product_id.default_code" />
                                    </td>
                                    <td colspan="2" style="border:1px solid black;text-align:left;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:1px solid black;font-family: Century Gothic;">
                                        <span t-esc="line.y_product_id.name" />
                                    </td>
                                    <td colspan="1" style="border:1px solid black;text-align:center;font-size:12px;font-family: Century Gothic;">
                                        <span t-esc="line.y_total_qty" />
                                    </td>
                                    <t t-if="line.y_group != prev_group">
                                        <td style="border:1px solid black;text-align:center;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;font-family: Century Gothic;">
                                            <t t-esc="line.y_total_package" />
                                        </td>
                                        <td style="border:1px solid black;text-align:center;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;font-family: Century Gothic;">

                                            <span t-esc="o.calculate_group_weights().get(line.y_group, {}).get('qty_in_package', 0.0)"  t-options="{'widget': 'float', 'precision': 2}"/>
                                            
                                        </td>
                                        <td style="border:1px solid black;text-align:center;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;font-family: Century Gothic;">
                                            <span t-esc="o.calculate_group_weights().get(line.y_group, {}).get('net_weight', 0.0)"  t-options="{'widget': 'float', 'precision': 2}"/>
