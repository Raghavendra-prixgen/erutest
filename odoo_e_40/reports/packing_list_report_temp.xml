                                            <span t-esc="total_gross_weight" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </t>
                                        <t t-else="">
                                            0
                                        </t>
                                        </td>
                                        <td colspan="2" style="border:1px solid black;text-align:right;font-family: Century Gothic;border-center:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                        </td>
                                    </tr>
                                    
                                    <tr>
                                        <div style="width: 100%;"> 
                                            <td colspan="12" style="border-right: 1px solid black; font-size: 11px; width: 95%; font-family: Century Gothic; white-space: normal;">
                                                    <b><span>Note: </span></b>
                                                    <span t-if="o.y_note" t-field="o.y_note" />
                                                </td>
                                        </div>
                                    </tr>
                            </t>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
