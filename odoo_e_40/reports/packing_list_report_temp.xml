<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="eruvaka_pl_paper_format" model="report.paperformat">
        <field name="name">eruvaka report</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">145</field>
        <field name="margin_bottom">35</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">140</field>
        <field name="dpi">90</field>
    </record>

    <record id="eruvaka_packing_list_report" model="ir.actions.report">
        <field name="name">Packing List Report</field>
        <field name="model">stock.quant.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_e_40.eruvaka_packing_list_custom_report</field>
        <field name="report_file">odoo_e_40.eruvaka_packing_list_custom_report</field>
        <field name="binding_model_id" ref="odoo_e_14_b.model_stock_quant_package" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="odoo_e_40.eruvaka_pl_paper_format" />
    </record>

    <template id='eruvaka_packing_list_custom_report'>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
