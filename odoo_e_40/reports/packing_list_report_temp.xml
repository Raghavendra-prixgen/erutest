                                    style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                        Gross Wt.(Kg)
                                    </th>
                                    <th colspan="2"
                                    style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                        Package Measurement(cm3)
                                    </th>
                                </tr>

                                
                                <t t-set="sl" t-value="1" />
