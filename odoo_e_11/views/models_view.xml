  <record id="stock_picking_form_view_inherited_custom" model="ir.ui.view">
    <field name="name">stock.picking.form.custom</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="odoo_e_08_b.view_picking_form_inherit_branch_to_branch" />
    <field name="arch" type="xml">
      <xpath expr="//form/sheet/group/group[1]/field[@name='location_dest_id'][2]"
        position="attributes">
        <attribute name="readonly">y_boolean_purchase_id == True or y_btb_id != False</attribute>
      </xpath>
    </field>
  </record>


  <record id="purchase_order_form_view_inherited" model="ir.ui.view">
    <field name="name">purchase.order.form</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='purchase_delivery_invoice']/group/group[2]" position="inside">
        <field name="y_notes" />
        <field name="y_vendor_code" />
        <field name="y_po_number" invisible="1" />
      </xpath>

      <xpath expr="//button[@name='action_rfq_send'][2]" position="attributes">
        <attribute name="invisible">state != 'done'</attribute>
      </xpath>


    </field>
  </record>

  <record id="res_partner_from_inherit_form" model="ir.ui.view">
    <field name="name">res.partner.form.inherit</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">


      <xpath expr="//field[@name='property_supplier_payment_term_id']" position="after">

        <field name="y_iec_no" />
        <field name="y_iec_date" />
        <field name="y_lut_no" />
        <field name="y_lut_valid_till" />
        <field name="y_reg_date" />


      </xpath>
      <!-- <xpath expr="//field[@name='ref']" position="after">
            <field name="y_contact_person"/>
        </xpath> -->
    </field>
  </record>

  <record id="sale_order_form_inherit" model="ir.ui.view">
    <field name="name">sale.order.form.inherit1</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
        <field name="y_is_free_sample"/>
      </xpath>



      <xpath expr="//page[@name='other_information']//group/group[2]//field[@name='invoice_status']"
        position="after">


        <field name="y_po_ref" />
        <field name="y_po_date" />
        <field name="y_shipping_method_id" sring="Shipping Method" />
        <field name="y_bank_details"/>
        <field name="y_bank_details_domain" invisible="1" />


      </xpath>
      <xpath expr="//field[@name='y_short_close_reason']" position="after">
        <field name="y_note" />
      </xpath>


    </field>
  </record>

  <record id="account_move_form_inherit" model="ir.ui.view">
    <field name="name">account.move.form.inherit1</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">

      <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
        <field name="y_is_free_sample" column_invisible="parent.move_type != 'out_invoice'"/>
      </xpath>

      <xpath expr="//field[@name='to_check']" position="after">
        <field name="y_lut_arn_nu" />
        <field name="y_valid_till" />
        <field name="y_note" />
        <field name="y_exchange_rate" invisible="1" />
      </xpath>
      <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='other_info']/group[1]/group[@name='sale_info_group']/field[@name='delivery_date']" position="after">
        <field name="y_bank_details"/>   
        <field name="y_bank_details_domain" invisible="1"/>     
      </xpath>
    </field>

    <!-- <xpath expr="//form/sheet/group/group[@id='header_right_group']//field[@name='partner_id']"
    position="after">
          <field name="y_exchange_rate"  invisible="0"/>
        </xpath> -->
  </record>
  <record id="account_move_inherit_custom_app" model="ir.ui.view">
    <field name="name">account.move.view.form.inherit.new</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="odoo_e_14_b.view_account_move_form_inherit_account_new_demoo" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='import_export_new']//field[@name='y_pre_carriage']"
        position="after">
        <field name="y_export_ref_no" />
      </xpath>
      <xpath expr="//page[@name='import_export_new']//field[@name='y_voyage_no']" position="after">
        <field name="y_export_ref_date" />
      </xpath>
    </field>
  </record>


  <record id="shipping_method_tree_view" model="ir.ui.view">
    <field name="name">shipping.method.tree</field>
    <field name="model">shipping.method</field>
    <field name="arch" type="xml">
      <tree string="Shipping Method">
        <field name="y_shipping_method" />
      </tree>
    </field>
  </record>


  <record
    id="shipping_method_form_view" model="ir.ui.view">
    <field name="name">shipping.method.form</field>
    <field name="model">shipping.method</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="y_shipping_method" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="account_move_inherit_custom_app" model="ir.ui.view">
    <field name="name">packaging.list.view.form.inherit.new</field>
    <field name="model">packaging.list</field>
    <field name="inherit_id" ref="odoo_e_14_b.view_packaging_list_document_form" />
    <field name="arch" type="xml">
      <!-- <xpath expr="//page[@name='stock_packages']//field[@name='y_sale_origin']"
      position="after">
                <field name="y_kit_product" optional="hide"/>
            </xpath> -->
      <xpath expr="//form//field[@name='y_container_seal_number']" position="after">
        <field name="y_note" />
      </xpath>
    </field>
  </record>


  <record id="bank_details_in_res_partner" model="ir.ui.view">
    <field name="name">bank.details.view.form</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Bank Details" name="bank_details">
          <group>
            <group string="Export Bank Accounts" name="banks_export" >
              <field name="y_export_bank_detail_ids" nolabel="1" colspan="2">
                <tree>
                  <field name="y_export_acc_number" widget="handle" force_save="1"/>
                  <field name="y_export_acc_number" string="Account Number"/>
                  <field name="y_export_acc_number_update"  string="Account Number" column_invisible="1"/>
                  <field name="y_export_bank_id" />
                  <field name="y_export_acc_holder_name" column_invisible="True" />
                </tree>
                <form action="">
                  <sheet>
                    <group>
                      <field name="y_export_acc_number_update" string="Account Number"/>
                      <field name="y_export_acc_number" string="Account Number" invisible="1"/>
                      <field name="y_export_bank_id" />
                      <field name="y_export_acc_holder_name" />
                    </group>
                  </sheet>
                </form>
              </field>
            </group>
            <group string="Domestic Bank Accounts" name="banks_domestic" >
              <field name="y_domestic_bank_detail_ids" nolabel="1" colspan="2">
                <tree>
                  <field name="y_domestic_acc_number" widget="handle" force_save="1"/>
                  <field name="y_domestic_acc_number" string="Account Number"/>
                  <field name="y_domestic_acc_number_update"  string="Account Number" column_invisible="1"/>
                  <field name="y_domestic_bank_id"/>
                  <field name="y_domestic_acc_holder_name" column_invisible="True" />
                </tree>
                <form action="">
                  <sheet>
                    <group>
                      <field name="y_domestic_acc_number_update" string="Account Number"/>
                      <field name="y_domestic_acc_number" string="Account Number" invisible="1"/>
                      <field name="y_domestic_bank_id"/>
                      <field name="y_domestic_acc_holder_name" />
                    </group>
                  </sheet>
                </form>
              </field>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

   <record id="bank_details_export_domestic_view_form" model="ir.ui.view">
    <field name="name">bank.details.export.domestic.view.form</field>
    <field name="model">bank.details.export.domestic</field>
    <field name="arch" type="xml">
      <form string="">
        <sheet>
            <group >
                  <field name="y_export_acc_number"  invisible="1"/>
                  <field name="y_export_acc_number_update" invisible="y_domestic_bank_id != False" string="Account Number"/>
                  
                  <field name="y_export_bank_id" invisible="y_domestic_bank_id != False"/>
                  <field name="y_export_acc_holder_name" invisible="y_domestic_bank_id != False"/>
            </group>
            <group>
              <field name="y_domestic_acc_number" invisible="1"/>
              <field name="y_domestic_acc_number_update" invisible="y_export_bank_id != False" string="Account Number"/>

              <field name="y_domestic_bank_id"  invisible="y_export_bank_id != False"/>
              <field name="y_domestic_acc_holder_name" invisible="y_export_bank_id != False"/>
            </group>
            
        </sheet>
      </form>
    </field>
   </record>

   <record id="bank_details_export_domestic_action" model="ir.actions.act_window">
    <field name="name">Action Name</field>
    <field name="res_model">bank.details.export.domestic</field>
    <field name="view_mode">tree,form</field>  
   </record>

  <record
    id="res_shipping_method_action" model="ir.actions.act_window">
    <field name="name">Shipping Method View</field>
    <field name="res_model">shipping.method</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_res_shipping_method"
    name="Shipping Method"
    action="odoo_e_11.res_shipping_method_action" parent="sale.menu_sale_general_settings"
    sequence="6" />
</odoo>