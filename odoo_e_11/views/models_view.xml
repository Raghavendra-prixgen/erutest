<odoo>

  <record id="view_product_form_product_warranty_inherits" model="ir.ui.view">
    <field name="name">view_product_warranty_inherit</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="after">
        <field name="y_product_warranty" />
      </xpath>
    </field>
  </record>

  <record id="view_product_form_product_template_warrantys" model="ir.ui.view">
    <field name="name">view_product_warranty_template</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="after">
        <field name="y_product_warranty" />
      </xpath>
    </field>
  </record>

  <record id="view_product_form_stock_lot_inherits" model="ir.ui.view">
    <field name="name">view_stock_lot_warranty_inherit</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_id']" position="after">
        <field name="y_motor_id" />
      </xpath>
    </field>
  </record>


  <record id="stock_picking_form_view_inherited" model="ir.ui.view">
    <field name="name">stock.picking.form</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='origin']" position="after">
        <field name="y_po_number" invisible="1" />
        <field name="y_invoice_number" readonly="state in ['cancel', 'done']" />
        <field name="y_date" readonly="state in ['cancel', 'done']" />
        <field name="y_boolean_purchase_id" invisible="1" />
      </xpath>
      <xpath expr="//field[@name='partner_id']" position="attributes">
        <attribute name="readonly">y_boolean_purchase_id == True or state in ['cancel', 'done']</attribute>
      </xpath>
      <xpath expr="//field[@name='scheduled_date']" position="attributes">
        <attribute name="readonly">y_boolean_purchase_id == True or state in ['cancel', 'done']</attribute>
      </xpath>
      <xpath expr="//field[@name='origin']" position="attributes">
        <attribute name="readonly">y_boolean_purchase_id == True or state in ['cancel', 'done']</attribute>
      </xpath>

      <xpath expr="//page[@name='extra']/group/group[@name='other_infos']/field[@name='company_id']"
        position="after">
        <field name="y_vehicle_no" />
        <field name="y_e_waybill_no" />
        <field name="y_res_state_id" />
        <field name="y_nature_of_supply" />
        <field name="y_note" />

      </xpath>
    </field>
  </record>


  <record id="product_template_only_form_view_internal_reference" model="ir.ui.view">
    <field name="name">product_template_only_form_view_internal_reference</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="attributes">
        <attribute name="readonly">1</attribute>
      </xpath>

    </field>
  </record>

  <record id="product_normal_form_view_internal_reference" model="ir.ui.view">
    <field name="name">product_normal_form_view_internal_reference</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="attributes">
        <attribute name="readonly">1</attribute>
      </xpath>
    </field>
  </record>


