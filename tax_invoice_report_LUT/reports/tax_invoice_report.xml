<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_tax_invoice_report" model="report.paperformat">
        <field name="name">Tax Invoice Report</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">160</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">155</field>
        <field name="dpi">95</field>
    </record>

    <record id="custom_tax_invoice_report_format" model="ir.actions.report">
        <field name="name">Eruvaka Tax Invoice Report LUT</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tax_invoice_report_LUT.eruvaka_tax_invoice_report</field>
        <field name="report_file">tax_invoice_report_LUT.eruvaka_tax_invoice_report</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="tax_invoice_report_LUT.custom_tax_invoice_report" />
    </record>

    <template id='eruvaka_tax_invoice_report'>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="tax_invoice_report_LUT.external_layout_for_eruvaka_header_footer">
                    <div class="page">
                    
                        <table colspan="12" class="table m-0 p-0 table-borderless table-sm"
                            style="border:1px solid black;border-top:none;font-family: Century Gothic;">
                            <tr style="border-bottom:1px solid black;">
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-bottom:1px solid black;vertical-align:middle;font-size:11px;"> Sl.No.</th>
                                <th colspan="2" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Code</th>
                                <th colspan="2" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Product</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">HSN / SAC</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Quantity</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">UOM</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Price</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Dis %</th>
                                <th colspan="2" style="border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">Subtotal</th>
                            </tr>
                            <t t-set="sl" t-value="1" />
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr style="border-bottom:1px solid black;border-top:none">
                                    <td colspan="1" style="border:1px solid black;text-align:center;font-size:11px;width:1%;border-right:1px solid black;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-esc="sl" />
                                        <t t-set="sl" t-value="sl+1" />
                                    </td>
                                    <td colspan="2" style="border:1px solid black;text-align:center;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id.default_code"
                                        t-field="line.product_id.default_code" /> 
                                        
                                    </td>
                                    <td colspan="2"  style="border:1px solid black;text-align:left;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id.name"
                                        t-field="line.product_id.name" />   
                                    </td>    
                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id.l10n_in_hsn_code"
                                        t-field="line.product_id.l10n_in_hsn_code" />                                         

                                    </td>
                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                         <span t-if="line.quantity"
                                        t-field="line.quantity"  t-options="{'widget': 'float', 'precision': 2}"/> 
                                    </td>

                                    <td colspan="1" style="border:1px solid black;text-align:center;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                         <span t-if="line.product_id.uom_id" t-field="line.product_id.uom_id" /> 
                                         
                                    </td>

                                    <td colspan="1"  style="border:1px solid black;text-align:right;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                           <span t-if="line.price_unit" t-field="line.price_unit"  t-options="{'widget': 'float', 'precision': 2}"/>  
                                   </td>

                                    <td colspan="1"  style="border:1px solid black;text-align:right;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-field="line.discount"/> 

                                    </td>
                                    <td colspan="2" style="border:1px solid black;text-align:right;font-size:11px;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <t t-esc="o.currency_id.symbol"/> <span t-esc="subtotal"/> 
                                        <span t-if="line.price_total"
                                        t-field="line.price_total"  t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                            </t>
                            <tr style="border-bottom:1px solid black;">
                                <th colspan="10"
                                style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                Grand Total(in <span t-field="o.currency_id.name" />)</th>
                                <td colspan="2"
                                style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                <span t-field="o.currency_id.symbol" /><span t-esc="o.amount_total"  t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                            </tr>
                            <tr style="border-bottom:1px solid black;">
                                <td colspan="12"
                                style="border:1px solid black;text-align:left;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:100%">
                                    <span>
                                        <strong>Total Invoice Value in Words : </strong>
                                    </span>
                                    <t t-set="amount_in_words" t-value="o.amount_in_words_acc_move()"/>
                                    <span  t-esc="amount_in_words"/>
                                 </td>
                            </tr>
                        </table>
                       
                        <div style="page-break-after:always"></div>
                        <table class="table-borderless table-sm" style="width:100%">
                            <thead>
                                <tr>
                                    <th class="m-0 p-0" style="width:100%;border-left:1px solid black;border-right:1px solid black;border-top:1px solid black;border-bottom:none;padding-bottom:-1px;"/> 
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="width:100%;border-bottom:1px solid black;">
                                    
                                    <td style="text-align:left;width:100%;border-left:1px solid black;border-right:1px solid black;border-top:none;">

                                            <span  style="text-align:left;font-size:12px;width:100%;"><strong>T &amp; C :</strong></span>
                                            <span style="text-align:left;font-size:11px;width:100%;" t-esc="o.narration"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div style="page-break-after:always"></div>
                        <table style="font-size: 11px; width: 100%; border: 1px solid black; padding-left: 10px;">
                        <tr>
                            <td style="width: 30%; border: 1px solid black; padding-left:3px;font-size:11px;">
                                <span>
                                    <div class="row">
                                        <div style="width:37%;">
                                            <strong><span>LUT ARN NO </span></strong>
                                        </div>
                                        <div style="width:3%;">:</div>
                                        <div style="width:60%;">
                                            <t t-if="o.company_id.partner_id.lut_no"><span t-field="o.company_id.partner_id.lut_no"></span>
                                            </t>
                                        </div>
                                    </div>
                                </span>
                                <span>
                                    <div class="row">
                                        <div style="width:37%;">
                                            <strong><span>Register Date </span></strong>
                                        </div>
                                        <div style="width:3%;">:</div>
                                        <div style="width:60%;">
                                            <t t-if="o.company_id.partner_id.y_reg_date"><span t-field="o.company_id.partner_id.y_reg_date"></span>
                                            </t>
                                        </div>
                                    </div>
                                </span>
                                <span><div class="row"><div style="width:37%;"><strong><span>Valid Till </span></strong></div><div style="width:3%;">:</div><div style="width:60%;"><t t-if="o.company_id.partner_id.lut_valid_till"><span t-field="o.company_id.partner_id.lut_valid_till"></span></t></div></div></span>
                            </td>
                            <td colspan="2" style="font-size: 11px; width: 70%; padding-right:3px; border: 1px solid black;text-align:right;">
                                <span>E.&amp;O.E.</span>
                              
                            </td>
                        </tr>
                        <tr>
               
                    
                        <td rowspan="2" style="font-size: 11px;;width: 47%; border: 1px solid black;padding-left:3px;font-size:11px;"> <strong>Note :<br /></strong>
                            <span style="padding-right:3px;padding-left:3px;" 
                            t-field="o.y_note">
                        </span>
                        </td>
                        <td rowspan="2" style="font-size: 11px; width: 30%; border: 1px solid black; padding-left:3px;font-size:11px;">
                              <span><div class="row"><div style="width:37%;"><strong>Bank Details</strong></div></div></span>
                              <span><div class="row"><div style="width:30%;">Name</div><div style="width:10%;">:</div><div style="width:60%;"> 
                                <span t-if="o.company_id.partner_id.bank_ids.bank_id"
                                        t-field="o.company_id.partner_id.bank_ids.bank_id"/>
                        </div></div></span>
                              <span><div class="row"><div style="width:30%;">Account No</div><div style="width:10%;">:</div><div style="width:60%;">
                                 <span t-if="o.company_id.partner_id.bank_ids.acc_number"
                                        t-field="o.company_id.partner_id.bank_ids.acc_number" />
                            </div></div></span>
                              <span><div class="row"><div style="width:30%;">SWIFT Code</div><div style="width:10%;">:</div><div style="width:60%;">
                                 <span t-if="o.company_id.partner_id.bank_ids.bank_id.bic"
                                        t-field="o.company_id.partner_id.bank_ids.bank_id.bic" />
                            </div></div></span>
                              <span><div class="row"><div style="width:30%;">IFSC Code</div> <div style="width:10%;">:</div><div style="width:60%;">
                                <span t-if="o.company_id.partner_id.bank_ids.bank_id.bic"
                                        t-field="o.company_id.partner_id.bank_ids.bank_id.bic" />
                            </div></div></span>
                        </td>
                        <td style="width: 23%;padding-left:3px;height:90px;text-align: center;font-size:11px;">
                            <strong><span>For</span><br />
                            <span t-field="o.company_id.name"></span></strong>
                            <br />
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 23%; border-top:1px solid black;padding-left:3px;text-align: center;font-size:11px;">
                            <span>Authorized Signatory</span><br />
                        </td>
                    </tr>
                       
                       
                    </table>
                    <table class="table table-borderless m-0 p-0">
                            <td style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;font-size:11px;font-family: Century Gothic;width:100%;" >
                                <div class="text-left" style="width:100%;padding-left:2px;">
                                    <span style="font-size:11px;font-family: Century Gothic;">* This is a
                                        computer generated document and authenticated by Eruvaka
                                        Technologies Pvt. Ltd.Hence, it can be considered valid even if not signed
                                        manually.</span>
                                </div>
                                    
                            </td>
                        </table> 

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>