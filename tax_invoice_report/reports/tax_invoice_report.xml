<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_tax_invoice_report" model="report.paperformat">
        <field name="name">Tax Invoice Report</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">145</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">141</field>
        <field name="dpi">90</field>
    </record>

    <record id="custom_tax_invoice_report_format" model="ir.actions.report">
        <field name="name">Eruvaka Tax Invoice Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tax_invoice_report.eruvaka_tax_invoice_report</field>
        <field name="report_file">tax_invoice_report.eruvaka_tax_invoice_report</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="tax_invoice_report.custom_tax_invoice_report" />
    </record>

    <template id='eruvaka_tax_invoice_report'>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="tax_invoice_report.external_layout_for_eruvaka_header_footer">
                    <div class="page">
                        <table class="table table-sm m-0 p-0 " style="border:1px solid black;border-top:none;width:100%;font-family: Century Gothic;">
                            <tr style="border-bottom:1px solid black;">

                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;vertical-align:middle;font-size:11px;width:1%"> Sl.No.</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:9%">Code</th>
                                <th colspan="2" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:26%">Product</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:8%">HSN / SAC</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:6%">Qty</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:6%">UOM</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:8%">Price</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:8%">Dis %</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:8%">Tax Rate(%)</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:8%">Tax</th>
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:12%;">Subtotal</th>
                               
                            </tr>
                                <t t-set="sl" t-value="1" />

                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr style="border-bottom:1px solid black;border-top:none">
                                    <td colspan="1" style="border:1px solid black;text-align:center;font-size:11px;width:1%;border-right:1px solid black;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-esc="sl" />
                                        <t t-set="sl" t-value="sl+1" />
                                    </td>
                                    <td colspan="1" style="border:1px solid black;text-align:center;font-size:11px;width:9%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id.default_code"
                                        t-field="line.product_id.default_code" /> 
                                        
                                    </td>
                                    <td colspan="2"  style="border:1px solid black;text-align:left;font-size:11px;width:26%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id"
                                        t-field="line.product_id" />   
                                   </td>    
                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;width:8%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id.l10n_in_hsn_code"
                                        t-field="line.product_id.l10n_in_hsn_code" />                                         

                                    </td>
                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;width:6%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                         <span t-if="line.quantity"
                                        t-field="line.quantity"  t-options="{'widget': 'float', 'precision': 2}"/> 
                                    </td>

                                    <td colspan="1" style="border:1px solid black;text-align:center;font-size:11px;width:6%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                         <span t-if="line.product_id.uom_id" t-field="line.product_id.uom_id" /> 
                                    </td>

                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;width:8%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                           <span t-if="line.price_unit" t-field="line.price_unit"  t-options="{'widget': 'float', 'precision': 2}"/>  
                                   </td>

                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;width:8%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.discount" t-field="line.discount" /> 

                                    </td>

                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;width:8%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-if="line.tax_ids" t-field="line.tax_ids" /> 

                                    </td>
                                    <td colspan="1"  style="border:1px solid black;text-align:center;font-size:11px;width:8%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                       <t t-set="tax" t-value="line.price_total - line.price_subtotal"/>
                                       <t t-esc="tax" t-options="{'widget': 'float', 'precision': 2}"/>



                                    </td>
                                    <td colspan="1" style="border:1px solid black;text-align:right;font-size:11px;width:12%;border-right:1px solid black;border-left:none;border-bottom:none;border-top:none;font-family: Century Gothic;">
                                        <span t-field="o.currency_id.symbol" />
                                        <span t-if="line.price_subtotal"  t-field="line.price_subtotal"  t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                               
                                </tr>
                            </t>
                            <tr style="border-bottom:1px solid black;">
                                <th colspan="11"
                                style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                Total Amount</th>
                                <td colspan="1"
                                style="padding-left:18px;border:1px solid black;text-align:right;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;">
                                <span t-field="o.currency_id.symbol" />
                                <span t-esc="o.amount_total" t-options="{'widget': 'float', 'precision': 2}"/> 
                                </td>
                            </tr>
                            <tr style="border-bottom:1px solid black;">
                                <td colspan="12"
                                style="border:1px solid black;text-align:left;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:100%">
                                    <strong><span>Amount (in words):</span></strong>
                                    <span  t-esc="o.amount_total_words"/>
                                 </td>
                            </tr>
                        </table>   

                     
                                
                        <div style="page-break-after:always"></div>
                        <table class="table-borderless table-sm" style="width:100%">
                            <thead>
                                <tr>
                                    <th class="m-0 p-0" style="width:100%;border-left:1px solid black;border-right:1px solid black;border-top:1px solid black;border-bottom:none;padding-bottom:-1px;"/> 
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="width:100%;border-bottom:1px solid black;">
                                    
                                    <td style="text-align:left;width:100%;border-left:1px solid black;border-right:1px solid black;border-top:none;">

                                            <span  style="text-align:left;font-size:12px;width:100%;"><strong>T &amp; C :</strong></span>
                                            <span style="text-align:left;font-size:11px;width:100%;" t-esc="o.narration"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div style="page-break-after:always"></div>
                        <table class="table m-0 p-0 table-borderless" style="page-break-inside: avoid;border:1px solid black;border-top:none;width:100%;font-family: Century Gothic;">

                            <tr >
                                <td colspan="20" style="border:1px solid black;font-size:11px;font-family: Century Gothic;width:50%;" >
                                    <span >
                                        <strong>Note :</strong>
                                    </span>
                                    <br />
                                    <br />

                                    <t t-if="o.y_note">
                                        <span t-field="o.y_note" />
                                    </t>
                                </td>
                                <td colspan="20" style="border:1px solid black;font-size:11px;font-family: Century Gothic;width:25%;" >
                                    <span >
                                        <strong>Bank Details</strong>
                                    </span>
                                    <br />
                                    <br />
                                    <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank" limit="1">
                                     <strong style="font-size:10px;">Name :</strong>
                                    <t t-if="bank.bank_id">
                                        <span t-field="bank.bank_id" />
                                    </t><br/>
                                     <strong style="font-size:10px;">Bank Account Number:</strong>
                                    <t t-if="bank.acc_number">
                                        <span t-field="bank.acc_number" />
                                    </t><br />
                                     <strong style="font-size:10px;">IFSC Code:</strong>
                                    <t t-if="bank.acc_number">
                                        <span t-field="bank.acc_number" />
                                    </t>
                                    </t>
                                </td>


                                <td colspan="20" style="border:1px solid black;font-size:11px;font-family: Century Gothic;width:25%;" >
                                    <div class="row">
                                        <div style="text-align:center;">
                                           <strong><span>For Eruvaka Technologies Private Limited </span></strong>
                                        </div>
                                        <br/>
                                        <br/>
                                        <br/>
                                    
                                        <br/>
                                        
                                    </div>
                                    <div class="row">
                                        <div style="text-align:center;">
                                           <strong><span>Authorized Signatory</span></strong> 
                                            
                                        </div>
                                    </div>
                                </td>
                            </tr>
                      </table>
                      <table class="table table-borderless m-0 p-0">
                            <td style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;font-size:11px;font-family: Century Gothic;width:100%;" >
                                <div class="text-left" style="width:100%;padding-left:2px;">
                                    <span style="font-size:11px;font-family: Century Gothic;">* This is a
                                        computer generated document and authenticated by Eruvaka
                                        Technologies Pvt. Ltd.Hence, it can be considered valid even if not signed
                                        manually.</span>
                                </div>
                                    
                            </td>
                        </table> 
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>