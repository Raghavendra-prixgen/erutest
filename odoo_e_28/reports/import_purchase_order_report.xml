                                    </div>
                                </td> -->
                            </tr>
                        </table>
                        
                        <div style="page-break-after:always"></div>
                    <table class="table-borderless table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th class="m-0 p-0" style="width:100%;border-left:1px solid black;border-right:1px solid black;border-top:1px solid black;border-bottom:none;padding-bottom:-1px;"/> 
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="width:100%;border-bottom:1px solid black;">
                                
                                <td style="text-align:left;width:100%;border-left:1px solid black;border-right:1px solid black;border-top:none;">

                                        <span  style="text-align:left;font-size:12px;width:100%;"><strong>Terms &amp; Conditions :</strong></span>
                                        <span style="text-align:left;font-size:11px;width:100%;" t-esc="o.notes"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="page-break-after:always"></div>
                    <table class="table table-borderless m-0 p-0">
                        
                        <td colspan="23" style="border:1px solid black;font-size:11px;font-family: Century Gothic;width:70%;" >
                            <span style="font-weight: bolder;">
                                <strong>Notes : </strong>
                            </span>
                            
                            <span t-if="o.y_notes"
                                t-field="o.y_notes" />
                                
                        </td>
                        <td colspan="23" style="border:1px solid black;font-size:11px;font-family: Century Gothic;width:30%" >
                            <div class="row">
                                    <div class="col-12" style="text-align:center;">
                                        
                                        
                                   <strong>  <span>For Eruvaka Technologies Private Limited </span></strong> 
                                    </div>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br />
                                    <br />
                    
                                </div>
                                <div class="row">
                                    <div class="col-12" style="text-align:center;">
                                       <span>Authorized Signatory</span>
                                       
                                    </div>
                                </div>
                            </td>
                    </table>
                    <table class="table table-borderless m-0 p-0">
                        <td style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;font-size:11px;font-family: Century Gothic;width:100%;" >
                            <div class="text-left" style="width:100%;padding-left:2px;">
                                <span style="font-size:11px;font-family: Century Gothic;">* This is a
                                    computer generated document and authenticated by Eruvaka
                                    Technologies Pvt. Ltd.Hence, it can be considered valid even if not signed
                                    manually.</span>
                            </div>
                                
