<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_import_purchase_order_report" model="report.paperformat">
        <field name="name">Import Purchase Order Report</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">140</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">135</field>
        <field name="dpi">90</field>
    </record>
    <record id="custom_import_purchase_order_report_format" model="ir.actions.report">
        <field name="name">Import Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_e_28.eruvaka_import_purchase_order</field>
        <field name="report_file">odoo_e_28.eruvaka_import_purchase_order</field>
        <field name="print_report_name">((object.name == False and 'Draft') or '%s' %
            (object.name))</field>
        <field name="binding_model_id" ref="model_purchase_order" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="odoo_e_28.custom_import_purchase_order_report" />
    </record>

    <template id='eruvaka_import_purchase_order'>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="odoo_e_28.external_layout_for_eruvaka_import_header_footer">
                    <div class="page">
                  
                        <table class="table  m-0 p-0 table-borderless" style="border:1px solid black;border-top:none;width:100%;font-family: Century Gothic;">
                           <thead>
                            <tr style="border:1px solid black;">
                                <th colspan="1" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;vertical-align:middle;font-size:11px;width:2%"> Sl.No.</th>
                                <th colspan="5" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:10%">Item Code</th>
                                <th colspan="8" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:18%"> Description</th>
                                <th colspan="5" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:10%">HSN/SAC</th>
                                <th colspan="5" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:10%">Qty</th>
                                <th colspan="5" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:5%">UOM</th>
                                <th colspan="5" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:13%">Expected Arrival</th>
                                <!-- <th colspan="5" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:10%">Currency</th> -->
                                <th colspan="5" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:15%;">Unit Price</th>
                                <th colspan="6" style="border:1px solid black;text-align:center;font-family: Century Gothic;border-right:1px solid black;border-left:none;vertical-align:middle;font-size:11px;width:17%;">Total</th>
 
                            </tr>
                        </thead>
                        <tbody style="border-bottom:none;"> 
                            
                            <t t-set="sl" t-value="1" />
                            <t t-set="toaltax" t-value="0" />
                            <t t-set="taxable" t-value="0" />
                            <t t-set="total_tax_included" t-value="0.0" />

                            <t t-foreach="o.order_line" t-as="line">
                                <tr style="border-bottom:none;border-top:none;page-break-inside:avoid;">
                                    <td colspan="1" style="border:1px solid black;text-align:center;font-size:11px;width:2%;border-right:1px solid black;font-family: Century Gothic;">
                                        <span t-esc="sl" />
                                        <t t-set="sl" t-value="sl+1" />
                                    </td>
                                    <td colspan="5" style="border:1px solid black;text-align:center;font-size:11px;width:10%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id.default_code"
                                            t-field="line.product_id.default_code" />
                                    </td>
                                    <td colspan="8" style="border:1px solid black;text-align:left;font-size:11px;width:18%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">
                                        <span t-if="line.name"  t-field="line.name" />

                                        <br />
                                    </td>
                                    <td colspan="5" style="border:1px solid black;text-align:center;font-size:11px;width:10%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">
                                        <span t-if="line.product_id.l10n_in_hsn_code"
                                            t-field="line.product_id.l10n_in_hsn_code" />

                                    </td>
                                    <td colspan="5" style="border:1px solid black;text-align:center;font-size:11px;width:10%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">
                                         <span t-if="line.product_qty"
                                            t-field="line.product_qty"  t-options="{'widget': 'float', 'precision': 2}"/> 

                                    </td>

                                    <td colspan="5" style="border:1px solid black;text-align:center;font-size:11px;width:5%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">
                                        <span t-if="line.product_uom" t-field="line.product_uom" />      
                                    </td>

                                    <td colspan="5" style="border:1px solid black;text-align:center;font-size:11px;width:10%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">
                                    
                                        <span t-if="line.date_planned" t-esc="line.date_planned.strftime('%d-%m-%Y')" />

                                   </td>

                                    <!-- <td colspan="5" style="border:1px solid black;text-align:center;font-size:11px;width:10%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">

                                            <span t-if="line.currency_id"
                                        t-field="line.currency_id" />
                                    </td> -->
                                    <td colspan="5" style="border:1px solid black;text-align:right;font-size:11px;width:10%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">


                                            <span
                                            t-field="line.price_unit"  t-options="{'widget': 'float', 'precision': 2}"/>
                                         </td>
                                    
                                    <td colspan="6" style="border:1px solid black;text-align:right;font-size:11px;width:14%;border-right:1px solid black;border-left:none;font-family: Century Gothic;">
                                         <span t-field="o.currency_id.symbol" />
    
                                            <span
                                            t-field="line.price_subtotal"  t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    

                                </tr>
                            </t>
                        </tbody>


