                            </tr>
                             
  
                              </tfoot> -->
                        </table>

                        <table class="table m-0 p-0 table-borderless" style="border-top:1px solid black;page-break-inside:avoid;width:100%;font-family: Century Gothic;">
                           <tr>
                               
                                <td colspan="44" style=" border-left:1px solid black;font-size:11px;font-family: Century Gothic;text-align:center;border-right:none;">
                                    <span style="font-weight: bolder;text-align:center;">
                                         Grand Total
                                    </span>

                                </td>
                                <td  colspan="6" style="border-right:1px solid black;font-size:11px;font-family: Century Gothic;text-align:right;border-left:none">
                                    <strong>
                                        <span t-field="o.currency_id.symbol" />
                                        <span t-esc="o.amount_total" t-options="{'widget': 'float', 'precision': 2}"/> 
                                    </strong>
                                </td>
                            </tr>
                          
                            <tr>
                                <td colspan="50" style="border:1px solid black;font-size:11px;font-family: Century Gothic;" width="100%">
                                    <span>
                                        <strong>Total Amount In Words : </strong>
                                    </span>

                                    <!-- <t t-set="amountwords" t-value="o.amount_in_words(o.tax_totals['amount_total'])" />
                                    <span t-esc="amountwords" />  -->
                                    <t t-set="amountwords"
                                         t-value="o.amount_in_words(o.amount_total)" />
                                    <span
                                        t-esc="o.currency_id.amount_to_text(o.amount_total).replace('And', '').strip()" />
                                </td>
                            </tr>
                            <tr >
                                <!-- <td colspan="25" style="border:1px solid black;font-size:11px;font-family: Century Gothic;width:70%" >
                                    <span style="font-weight: bolder; text-decoration: underline;">
                                        <strong>Notes</strong>
                                    </span>
                                    <br />
