<odoo>
  <data>

    <record model="ir.ui.view" id="material_request_list">
      <field name="name">material_request list</field>
      <field name="model">material.request</field>
      <field name="arch" type="xml">
        <tree>
          <field name="y_name"/>
          <field name="activity_ids" widget="list_activity"/>
          <!-- <field name="analytic_distribution" invisible="1"/> -->
          <field name="create_uid"/>
          <field name="create_date"/>
          <field name="y_responsible_id"/>
        </tree>
      </field>
    </record>

    <record id="view_material_request_filter" model="ir.ui.view">
      <field name="name">material.request.select</field>
      <field name="model">material.request</field>
      <field name="arch" type="xml">
          <search string="Search Material Request">
              <field name="y_name" string="Material Request" />
              <field name="y_picking_type_id" string="Operation Type"/>
              <field name="create_uid" string="Created By"/>              
         </search>
      </field>
    </record>

    <record model="ir.ui.view" id="material_request_form">
      <field name="name">material_request form</field>
      <field name="model">material.request</field>
      <field name="arch" type="xml">
        <form>
          <header>
            

            <button type="object" name="request_material" string="Process" class="oe_highlight" invisible="y_state != 'draft' or y_material_rqt_bool != False" />
            <button type="object" name="close" string="Close" class="oe_highlight" invisible="y_state != 'draft'"/>
            <button type="object" name="reset" invisible="y_state != 'closed'" icon="fa-unlock"/>
            <field name="y_state" widget="statusbar" statusbar_visible="draft,closed"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_mr_picking" class="oe_stat_button" icon="fa-truck"
                type="object" help="List view of picking operations" context="{'y_material_request_id': id, 'create':False}" invisible="y_picking_count == 0">
                <div class="o_form_field o_stat_info">
                  <span class="o_stat_text">Transfers</span>
                </div>
                <field name="y_picking_count" invisible="1"/>
                <field name="y_material_rqt_bool" invisible="1"/>
              </button>
              
              <button name="action_mr_purchase" class="oe_stat_button" icon="fa-sign-in"
                type="object" help="List view of purchase operations" context="{'y_material_request_id': id, 'create':False}" invisible="y_purchase_count == 0">
                <div class="o_form_field o_stat_info">
                  <span class="o_stat_text">Purchase</span>
                  <span class="o_stat_text">Requests</span>
                </div>
                <field name="y_purchase_count" invisible="1"/>
              </button>
            </div>

            <h1>
              <field name="y_name" readonly="1"/>
              <field name="y_request_material_boolean" invisible="1"/>
            </h1>
            <group>
              <group>
                <field name="y_picking_type_id"
                  options="{'no_create': True, 'no_create_edit':True}" 
                   domain="[('code','=','internal')]"/>
                <field name="y_source_location_id"
                  options="{'no_create': True, 'no_create_edit':True}"
                 />
                <field name="y_dest_location_id"
                  options="{'no_create': True, 'no_create_edit':True}"
                  />
                <field name="y_purchase_request_type_id" options="{'no_create': True, 'no_create_edit':True}"/>
                
              </group>
              <group>
                <field name="create_uid" string="Requested By" readonly="1"/>
                <field name="create_date" string="Date" readonly="1"/>
                <field name="y_responsible_id" options="{'no_create': True, 'no_create_edit':True}"/>
                <!-- <field name="analytic_distribution" widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting" string="Analytic Account"
                    /> -->
                <!-- <field name="y_analytic_groupby_account_ids" widget="many2many_tags" invisible="1"/> -->
                <field name="y_company_id" options="{'no_create': True, 'no_create_edit':True}"/>
              </group>
            </group>
            <notebook>
              <page string="Materials">
                <field name="y_material_request_line_ids" >
                  <tree editable="bottom" decoration-danger="y_available_qty == 0">
                    <field name="y_request_type" required="1" optional="show"/>
                    <field name="y_purchase_request_type_id"                     
                      options="{'no_create': True, 'no_create_edit':True}" 
                      readonly="y_request_type != 'purchase'"
                      optional="hide"/>
                    <field name="y_picking_type_id"
                      options="{'no_create': True, 'no_create_edit':True}"
                      optional="hide" domain="[('code','=','internal')]"/>
                    <field name="y_source_location_id"
                      options="{'no_create': True, 'no_create_edit':True}"
                      optional="hide"/>
                    <field name="y_dest_location_id"
                      options="{'no_create': True, 'no_create_edit':True}"
                      optional="hide"/>
                    <field name="y_product_id" optional="show"
                    options="{'no_create': True, 'no_create_edit':True}"/>
                    <!-- <field name="analytic_distribution" widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting" string="Analytic Account"
                    options="{'product_field': 'y_product_id'}" optional="hide"/> -->
                    <field name="y_available_qty" optional="hide"/>
                    <field name="y_forcast_qty" optional="hide"/> 
                    <field name="y_planned_qty" optional="show" readonly="y_requested_qty > 0"/>
                    <field name="y_request_qty" optional="show"/>
                    <field name="y_requested_qty" optional="hide"/>
                    <field name="y_transfer_order_ids" optional="hide" widget="many2many_tags"/>
                    <field name="y_purchase_request_ids" optional="hide" widget="many2many_tags"/>
                  </tree>
                  <form>                  
                  </form>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

