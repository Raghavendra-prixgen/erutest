<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_purchase_order_own_documents" model="ir.rule">
        <field name="name">Purchase Order: Own Documents</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="rule_purchase_order_all_documents" model="ir.rule">
        <field name="name">Purchase Order: All Documents</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
        <!-- <field name="groups" eval="[(4, ref('base.group_system'))]"/> -->
    </record>
    
    <record id="rule_purchase_order_1st_lvl_approval" model="ir.rule">
        <field name="name">Purchase Order: 1st Lvl Approval</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[
            '&amp;','&amp;', '|',
            ('y_approver_visible', '=', True),
            
            ('user_id', '=', user.id),
            ('y_purchase_lvl_amt_approval_line.y_lvl1_user_ids', 'in', [user.id]),
            '|',
            ('y_purchase_lvl_amt_approval_line.y_is_1st_user_completed', '=', False),
            ('y_purchase_lvl_amt_approval_line.y_is_1st_user_completed', '=', True)
        ]</field>
        <field name="groups" eval="[(4, ref('odoo_e_41.1st_lvl_approve'))]"/>
    </record>
    
    
    <!-- Record Rule for 2nd Level Approval -->
    <record id="rule_purchase_order_2nd_lvl_approval" model="ir.rule">
        <field name="name">Purchase Order: 2nd Lvl Approval</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[
            '&amp;', '&amp;','|',
            ('y_approver_visible', '=', True),  
          
            ('user_id', '=', user.id), 
            ('y_purchase_lvl_amt_approval_line.y_lvl2_user_ids', 'in', [user.id]),  
            '&amp;',
            ('y_purchase_lvl_amt_approval_line.y_is_1st_user_completed', '=', True), 
            '|',
            ('y_purchase_lvl_amt_approval_line.y_is_2nd_user_completed', '=', False), 
            ('y_purchase_lvl_amt_approval_line.y_is_2nd_user_completed', '=', True),  
        ]</field>
        <field name="groups" eval="[(4, ref('odoo_e_41.2nd_lvl_approve'))]"/>
    </record>
    
    <!-- Record Rule for 3rd Level Approval -->
    <record id="rule_purchase_order_3rd_lvl_approval" model="ir.rule">
