            '&amp;',
            ('y_purchase_lvl_amt_approval_line.y_is_1st_user_completed', '=', True), 
            '&amp;',
            ('y_purchase_lvl_amt_approval_line.y_is_2nd_user_completed', '=', True), 
            '|',
            ('y_purchase_lvl_amt_approval_line.y_is_3rd_user_completed', '=', False), 
