<odoo>
    
    <record id="view_cogs_report_wizard" model="ir.ui.view">
        <field name="name">cogs.register.wizard</field>
        <field name="model">cogs.register.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <group>
                   
                    <group>
                        <field name="y_start_date" string="Start Date" required='1'/>
                        <field name="y_company_ids" string="Companys" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="y_end_date" string="End Date" required='1'/>
                    </group>
                </group>
            
                <footer>
                    <group>
                        <button class="btn btn-primary" type="object" name="retrieve_register" string="View Register"/>
                    </group>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>