<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_line_detailed_operation_tree_view_inherit" model="ir.ui.view">
      <field name="name">stock.move.line.operations.tree.view</field>
      <field name="model">stock.move.line</field>
      <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
      <field name="arch" type="xml">
          <field name="product_id" position="attributes">
            <attribute name="context">{'default_type': 'product'}</attribute>
          </field>
          <field name="location_id" position="attributes">
            <attribute name="domain">[('id', 'child_of', parent.location_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]</attribute>
          </field>
          <field name="location_dest_id" position="attributes">
            <attribute name="domain">[('id', 'child_of', parent.location_dest_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]</attribute>
          </field>
          <field name="lot_id" position="attributes">
            <attribute name="domain">[('company_id','=',company_id),('product_id','=',product_id),('y_show_lot','=',True)]</attribute>
            <attribute name="context">{'default_product_id': product_id, 'default_company_id': company_id, 'active_picking_id': picking_id, 'active_model':active_id}</attribute>
          </field>
          <!-- <field name="product_uom_id" position="attributes">
            <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
          </field> -->
      </field>
    </record>


</odoo>