<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_approval_form" model="ir.ui.view">
        <field name="name">sale.approval.form</field>
        <field name="model">sale.approval</field>
        <field name="arch" type="xml">
          <form string="Sales Approval" >
            <sheet>
                <group>
                    <group>
                        <field name="document_type_id" required='1' options="{'no_create': True, 'no_open': True}"/>
                        <field name="name" />
                        <field name="warehouse_id" required='0' options="{'no_create': True, 'no_open': True}"/>
                        <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" groups="base.group_multi_company"/>
                        <field name="approval_method" required='1'  widget="radio"/>
                    </group>
                <group>
                </group>
                </group>
                    <notebook>
                        <page string="Levels" name="products" attrs="{'invisible':[('approval_method', '!=','stages')]}">
                            <field name="approval_lines" widget="section_and_note_one2many" >
                                <tree string="Sales Approval Lines" editable="bottom">
                                    <field name='user_ids'  widget="many2many_tags" required='1' options="{'no_create': True, 'no_open': True}"/>
                                    <field name='role' />
                                    <field name='approval_amount' invisible="1"/>
                                    
                                    <field name='approval_one' attrs="{'column_invisible':[('parent.approval_method', '==','amount')]}"/>
                                    <field name='approval_two' attrs="{'column_invisible':[('parent.approval_method', '==','amount')]}"/>
                                    <field name='approval_three' attrs="{'column_invisible':[('parent.approval_method', '==','amount')]}"/>
                                    <field name='approval_amount_from' attrs="{'column_invisible':[('parent.approval_method', '==','stages')]}"/>
                                    <field name='approval_amount_to' attrs="{'column_invisible':[('parent.approval_method', '==','stages')]}"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Amount" name="amount" attrs="{'invisible':[('approval_method', '!=','amount')]}">
                            <field name="approval_lines" widget="section_and_note_one2many" >
                                <tree string="Sales Approval Lines" editable="bottom">
                                    <field name='user_ids'  widget="many2many_tags" required='1' options="{'no_create': True, 'no_open': True}"/>
                                    <field name='role' />
                                    <field name='approval_amount' invisible="1"/>
                                    
                                    <field name='approval_one' attrs="{'column_invisible':[('parent.approval_method', '==','amount')]}"/>
                                    <field name='approval_two' attrs="{'column_invisible':[('parent.approval_method', '==','amount')]}"/>
                                    <field name='approval_three' attrs="{'column_invisible':[('parent.approval_method', '==','amount')]}"/>
                                    <field name='approval_amount_from' attrs="{'column_invisible':[('parent.approval_method', '==','stages')]}"/>
                                    <field name='approval_amount_to' attrs="{'column_invisible':[('parent.approval_method', '==','stages')]}"/>
                                </tree>
                            </field>
                        </page>



                        <page string="Level and Amount" name="lvlandamount" attrs="{'invisible':[('approval_method', '!=', 'lvlsamt')]}">
                            <field name="lvl_amt_approval_lines" widget="section_and_note_one2many" >
                                <tree string="Lvl and Amt Approval Lines" editable="bottom">
                                    <field name='approval_level' />
                                    <field name='lvl1_user_ids'  widget="many2many_tags"  options="{'no_create': True, 'no_open': True}" attrs="{'required':[('approval_level', 'in', ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval'))]}"/>
                                    <field name='lvl2_user_ids'  widget="many2many_tags"  options="{'no_create': True, 'no_open': True}" attrs="{'readonly':[('approval_level', '=', '1stlvlapproval')],'required':[('approval_level', 'in', ('3rdlvlapproval','2ndlvlapproval'))]}"/>
                                    <field name='lvl3_user_ids'  widget="many2many_tags"  options="{'no_create': True, 'no_open': True}" attrs="{'readonly':[('approval_level', 'in', ('1stlvlapproval','2ndlvlapproval'))],'required':[('approval_level', '=','3rdlvlapproval')]}"/>
                                    
                                    <field name='approval_amount_from' required="1"/>
                                    <field name='approval_amount_to' required="1"/>
                                    <field name='lvl_approval_id' invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
          </form>
        </field>
      </record>

       <record id="view_sale_approval_form_tree" model="ir.ui.view">
            <field name="name">sale.approval.tree</field>
            <field name="model">sale.approval</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <tree string="Sales Approval" >
                    <field name="document_type_id"/>
                    <field name="warehouse_id"/>
                    <field name="approval_method"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="view_sale_approval_search_view" model="ir.ui.view">
            <field name="name">sale.approval.search</field>
            <field name="model">sale.approval</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="active" string="Active" domain="[('active', '!=', False)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record model="ir.rule" id="sale_approval_record_restricted_company_rule">
            <field name="name">Sale Approval Restricted Record: multi-company</field>
            <field name="model_id" ref="model_sale_approval"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('y_company_id', '=', False), ('y_company_id', 'in', company_ids)]
            </field>
        </record>

       

        <record id="action_sale_approval" model="ir.actions.act_window">
            <field name="name">Sale Approval</field>
            <field name="res_model">sale.approval</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem 
            id="menu_sale_approval" 
            name="Sale Approval" 
            parent="sale.menu_sale_config"
            action="action_sale_approval" sequence="45"
        />



    <record id="sale_order_SO_approval" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="before">
                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': ['|','|',('state', 'in', ('sale', 'done','reject')),('is_approval_req','=',False),('so_approval_method','!=','lvlsamt')]}">
                  The SO total amount is out of the Approval Grid. <br/>
                   You can confirm the Sale Order.
                </div>
            </xpath>

            
            <button name="action_draft" position="attributes">
                <attribute name="states">cancel,reject</attribute>
            </button>


            <button name="action_draft" position="after" >
                <button name="get_approval" type="object" class="oe_highlight" attrs="{'invisible': ['|','|',('state', 'in', ('sale', 'done','reject')),('is_approved','=',False),('is_approval_req','!=',False)]}" string="Approve"/>
                <field name="is_approved" invisible="1"/>
                <field name="is_approval_req" invisible="1"/>
                <button name="%(odoo_e_31_b.action_sale_approval_remarks)d" type="action" class="oe_highlight" string="Reject"  attrs="{'invisible': ['|','|',('state', 'in', ('sale', 'done','reject')),('is_approved','=',False),('is_approval_req','!=',False)]}"/>
            </button>

            <field name="currency_id" position='after'>
                <field name="so_approval_method" invisible ='1'/>
                <field name ="current_approvall" invisible ='1'/>
                <field name ="approval_method" invisible ='1'/>
                <field name="to_approve_states" invisible="1"/>
            </field>

            <notebook position="inside">
                <page string="Approvals" attrs="{'invisible': ['|',('so_approval_method','=',False),('so_approval_method','=','lvlsamt')]}">
                    <field name='sale_approval_line' widget="section_and_note_one2many" readonly="1">
                        <tree>
                            <field name='user_ids' widget="many2many_tags"/>
                            <field name='role'/>
                            <field name='approvals'/>
                            <field name='approved_date'/>
                            <field name='is_approve'/>
                            <field name='remarks'/>
                            <field name='amount' invisible='1'/>
                            <field name='approval_method' invisible='1'/>
                        </tree>
                    </field>
                </page>


                <page string="Approvals Level and Amount" attrs="{'invisible': [('so_approval_method','!=','lvlsamt')]}">
                    <field name='sale_lvl_amt_approval_line' widget="section_and_note_one2many" readonly="1">
                        <tree>
                            <field name='approval_level'/>
                            <field name='lvl1_user_ids' widget="many2many_tags" />
                            <field name="is_1st_user_completed" invisible="1"/>
                            <field name="approved_date1" string="Level1" />

                            <field name='lvl2_user_ids' widget="many2many_tags" attrs="{'column_invisible': [('approval_level','!=','2ndlvlapproval')]}"/>
                            <field name="is_2nd_user_completed" invisible="1"/>
                            <field name="approved_date2" string="Level2" attrs="{'column_invisible': [('approval_level','!=','2ndlvlapproval')]}"/>

                            <field name='lvl3_user_ids' widget="many2many_tags" attrs="{'column_invisible':[('approval_level','!=','3rdlvlapproval')]}"/>
                            <field name="is_3rd_user_completed" invisible="1"/>
                            <field name="approved_date3" string="Level3" attrs="{'column_invisible':[('approval_level','!=','3rdlvlapproval')]}"/>

                            <field name='approval_amount_from'/>
                            <field name='approval_amount_to'/>
                            
                            <field name='sale_lvl_id' invisible='1'/>
                            <field name="is_approval_completed"/>
                            <field name="remarks"/>
                        </tree>
                    </field>
                </page>
             </notebook>
            </field>
    </record>

    <record id="sale_order_tree_view_newx" model="ir.ui.view">
        <field name="name">sale.order.tree.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="to_approve_states" widget="badge"/>
            </field>
        </field>
    </record>


</odoo>
