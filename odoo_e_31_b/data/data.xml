<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="blanket_sequence" model="ir.sequence">
        <field name="name">Sale Blanket Sequence</field>
        <field name="code">sale.blanket</field>
        <field name="prefix">BO/</field>
        <field name="padding">3</field>
    </record>

    <record id="cron_blanket_expiry_view" model="ir.cron">
        <field name="name">Automatically Expire Blanket Orders</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="model_id" ref="model_sale_order"/>
        <field name="code">model.expire_blanket_orders()</field>
        <field name="state">code</field>
    </record>

</odoo>
