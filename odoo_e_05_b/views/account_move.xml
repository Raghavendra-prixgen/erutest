<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_form_inherit" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="journal_div" position="after">
                <field name="y_journal_type" invisible="1"/>
                <field name="y_payment_type" invisible="y_journal_type not in ['cash','bank']" required="y_journal_type in ['cash','bank']" />
            </div>
        </field>
    </record>

    <record id="account_account_list_view_inherit" model="ir.ui.view">
        <field name="name">account.account</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][2]" position="attributes">
                <attribute name="domain">[('parent_id', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>