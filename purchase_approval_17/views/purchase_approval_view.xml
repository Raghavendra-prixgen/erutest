<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_doc_teype_view_tree_is_approval_required" model="ir.ui.view">
        <field name="name">purchase.doc.type.view.tree.inherited</field>
        <field name="model">purchase.doc.type</field>
        <field name="inherit_id" ref="purchase_base_17.purchase_doc_type_view_tree"/>
        <field name="arch" type="xml">
            <field name="y_company_id" position="after">
                <field name="is_approval_required" widget="boolean_toggle" string="Approval Required"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_approval_form" model="ir.ui.view">
        <field name="name">purchase.approval.form</field>
        <field name="model">purchase.approval</field>
        <field name="arch" type="xml">
            <form string="Purchase Approval" >
                <sheet>
                <group>
                    <group>
                        <field name="document_type_id" required='1' options="{'no_create': True, 'no_open': True}"/>
                        <field name="name" />
                        <field name="warehouse_id" required='0' options="{'no_create': True, 'no_open': True}"/>
                        <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" groups="base.group_multi_company"/>
                        <field name="approval_method" required='1'  widget="radio"/>
                    </group>
                <group>
                </group>
                </group>
                <notebook>
                    <page string="Products" name="products" invisible="approval_method in ('lvlsamt')">
                        <field name="approval_lines" widget="section_and_note_one2many" >
                            <tree string="Purchase Approval Lines" editable="bottom">
                                <field name='user_ids'  widget="many2many_tags" required='1' options="{'no_create': True, 'no_open': True}"/>
                                <field name='role' />
                                <field name='approval_amount' invisible="1"/>
                                
                                <field name='approval_one' column_invisible="parent.approval_method == 'amount'"/>
                                <field name='approval_two' column_invisible="parent.approval_method == 'amount'"/>
                                <field name='approval_three' column_invisible="parent.approval_method == 'amount'"/>
                                <field name='approval_amount_from' column_invisible="parent.approval_method == 'stages'"/>
                                <field name='approval_amount_to' column_invisible="parent.approval_method == 'stages'"/>
                            </tree>
                        </field>
                    </page>

                    <page string="Level and Amount" name="lvlandamount" invisible="approval_method not in ('lvlsamt')">
                        <field name="lvl_amt_approval_lines" widget="section_and_note_one2many" >
                            <tree string="Lvl and Amt Approval Lines" editable="bottom">
                                <field name='approval_level' />
                                <field name='lvl1_user_ids'  widget="many2many_tags"  options="{'no_create': True, 'no_open': True}" required="approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval')"/>
                                <field name='lvl2_user_ids'  widget="many2many_tags"  options="{'no_create': True, 'no_open': True}" readonly="approval_level == '1stlvlapproval'" required="approval_level in ('3rdlvlapproval','2ndlvlapproval')"/>
                                <field name='lvl3_user_ids'  widget="many2many_tags"  options="{'no_create': True, 'no_open': True}" readonly="approval_level in ('1stlvlapproval','2ndlvlapproval')" required="approval_level in ('3rdlvlapproval')"/>
                                
                                <field name='approval_amount_from' required="1"/>
                                <field name='approval_amount_to' required="1"/>
                                <field name='lvl_approval_id' invisible="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="view_purchase_approval_form_tree" model="ir.ui.view">
        <field name="name">purchase.approval.tree</field>
        <field name="model">purchase.approval</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <tree string="Purchase Approval" >
                <field name="document_type_id"/>
                <field name="warehouse_id"/>
                <field name="approval_method"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_approval_search_view" model="ir.ui.view">
        <field name="name">purchase.approval.search</field>
        <field name="model">purchase.approval</field>
        <field name="arch" type="xml">
            <search>
                <filter name="active" string="Active" domain="[('active', '!=',False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record model="ir.rule" id="purchase_approval_record_restricted_company_rule">
        <field name="name">Purchase Approval Restricted Record: multi-company</field>
        <field name="model_id" ref="model_purchase_approval"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record model="ir.ui.view" id="purchase_order__approval">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='y_doc_type_id']" position="after">
                <field name="product_ids" widget="many2many_tags" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="before">
                <div class="alert alert-warning oe_edit_only" role="alert" invisible="state in ('purchase', 'done','reject') or is_approval_req == False or po_approval_method != 'lvlsamt'">
                  The PO total amount is out of the Approval Grid. <br/>
                   You can confirm the Purchase Order.
                </div>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="get_approval" type="object" class="oe_highlight" string="Approve" invisible="state in ('purchase', 'done','reject','cancel') or is_approved == False or is_approval_req != False"/>
                <button name="get_set_draft" type="object" class="oe_highlight" string="Set to Draft" invisible="state not in ('reject')"/>
                <field name="is_approved" invisible="1"/>
                <field name="is_approval_req" invisible="1"/>
                <button name="%(purchase_approval_17.action_purchase_approval_remarks)d" type="action" class="oe_highlight" string="Reject" invisible="state in ('sale', 'done','reject') or is_approved == False or is_approval_req != False"/>
            </xpath>
            <field name="currency_id" position='after'>
                <field name="po_approval_method" invisible='1'/>
                <field name ="current_approvall" invisible='1'/>
                <field name ="approval_method"  invisible='1'/>
                <field name="to_approve_states"  invisible='1'/>
                <field name="is_1st_lvl_approval" invisible="1"/>
                <field name="is_2nd_lvl_approval" invisible="1"/>
                <field name="is_3rd_lvl_approval" invisible="1"/>
                <field name="show_warning" invisible="1"/>
            </field>
            <notebook position="inside">
                <page string="Approvals" invisible="po_approval_method == False or po_approval_method == 'lvlsamt'">
                    <field name='purchase_approval_line' widget="section_and_note_one2many" readonly="1">
                        <tree>
                            <field name='user_ids' widget="many2many_tags"/>
                            <field name='role'/>
                            <field name='approvals'/>
                            <field name='approved_date'/>
                            <field name='is_approve'/>
                            <field name='remarks'/>
                            <field name='amount'/>
                            <field name='approval_method'/>
                            <field name='is_email_sent'/>
                        </tree>
                    </field>
                </page>
                <page string="Approvals" invisible="po_approval_method != 'lvlsamt'">
                    <field name='purchase_lvl_amt_approval_line' widget="section_and_note_one2many" readonly="1">
                        <tree>
                            <field name='approval_level'/>
                            <field name='lvl1_user_ids' widget="many2many_tags"/>
                            <field name="is_1st_user_completed"/>
                            <field name="approved_date1"/>
                            <field name='lvl2_user_ids' widget="many2many_tags"/>
                            <field name="is_2nd_user_completed"/>
                            <field name="approved_date2"/>
                            <field name='lvl3_user_ids' widget="many2many_tags"/>
                            <field name="is_3rd_user_completed"/>
                            <field name="approved_date3"/>
                            <field name='approval_amount_from'/>
                            <field name='approval_amount_to'/>
                            <field name='purchase_lvl_id'/>
                            <field name="is_approval_completed"/>
                            <field name="remarks"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>


    <record id="action_purchase_approval" model="ir.actions.act_window">
        <field name="name">Purchase Approval</field>
        <field name="res_model">purchase.approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem 
        id="menu_purchase_approval" 
        name="Purchase Approval" 
        parent="purchase_base_17.menu_product_in_config_purchase_others"
        action="action_purchase_approval" sequence="45"
    />

    <record id="purchase_order_filter_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.filter</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_approve']" position="replace">
            </xpath>
            <xpath expr="//filter[@name='late_rfqs']" position="after">
                <filter name="to_approve_states" string="Pending For Approval" domain="[('to_approve_states', 'in', ('to_approve_state1','to_approve_state2','to_approve_state3'))]"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_view_new" model="ir.ui.view">
        <field name="name">purchase.order.tree.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="to_approve_states" widget="badge"/>
            </field>
        </field>
    </record>
</odoo>
