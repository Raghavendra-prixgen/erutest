<odoo>
    <data noupdate="1">
        <record id="seq_sample_plan" model="ir.sequence">
            <field name="name">Sample Plan Document Sequence</field>
            <field name="code">sample.plan</field>
            <field name="prefix">SP</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="seq_sample_observation" model="ir.sequence">
            <field name="name">Sample Observation Document Sequence</field>
            <field name="code">sample.observation</field>
            <field name="prefix">SOB/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
