<odoo>
    
    <record id="invoice_reconciliation_report_wizard_view_form" model="ir.ui.view">
        <field name="name">invoice.reconciliation.report.form</field>
        <field name="model">invoice.reconciliation.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice Report Form">
                <group>
                    <field name="y_project_report_printed" invisible="1"/> 
                    <group>
                        <field name="y_start_date" required="1" invisible="y_project_report_printed != False"
                        />
                        <!-- <field name="y_choose_on" widget='radio' string="Choose From" invisible="y_project_report_printed != False"/> -->
                        <field name="y_choose_on" widget='radio' string="Choose From" invisible="1"/>
                    </group>
                    <group >
                        <field name="y_end_date" required="1" invisible="y_project_report_printed != False"/>
                    </group>                
                </group>
                <group >
                        <field name="y_file_name" invisible="1"/>
                        <field name="y_project_report" readonly="1" filename="y_file_name" invisible="y_project_report_printed != True"/>
                </group>
                <footer>
                    <button string="Generate Report" type="object" name="get_invoice_report" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" type="object" class="btn btn-secondary oe_inline"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_reconciliation_report_wizard" model="ir.actions.act_window">
        <field name="name">Invoice Bank Upload Format Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">invoice.reconciliation.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="invoice_reconciliation_report_wizard_view_form"/>
        <field name="target">new</field>
    </record>
    
    
    <menuitem id="menu_invoice_reconciliation_report_wizard"
            name="Invoice Bank Upload Format Report"
            action="action_invoice_reconciliation_report_wizard"
            parent="account.menu_finance_reports"
            sequence="2"/>
    
</odoo>