<?xml version="1.0" ?>
<odoo>
    <record id="view_purchase_request_reason_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.reason.wizard.form</field>
        <field name="model">purchase.request.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <field name="y_request_id" invisible="1" />
                <field name="y_action_type" invisible="1" />
                <group>
                    <group>
                        <field
                            name="y_reason"
                            string="Cancellation Reason"
                            required="1"
                            invisible="y_action_type != 'cancel'"
                        />
                        <field
                            name="y_reason"
                            string="Rejection Reason"
                            required="1"
                            invisible="y_action_type != 'reject'"
                        />
                    </group>
                </group>
                <footer>
                    <button name="button_confirm" type="object" string="Confirm Cancel"
                        class="btn-primary" invisible="y_action_type != 'cancel'" />
                    <button name="button_confirm" type="object" string="Confirm Reject"
                        class="btn-primary" invisible="y_action_type != 'reject'" />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>