<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="choose_purchase_charges_view_form" model="ir.ui.view">
        <field name="name">choose.purchase.charges.form</field>
        <field name="model">choose.purchase.charges</field>
        <field name="arch" type="xml">
            <form string="Purchase Charges">
                <field name="y_purchase_id" invisible="1"/>
                <group>
                    <field name='y_product_id' options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'/>
                    <field name='y_unit_price'/>
                </group>
                <footer>
                    <button name="action_put_in_charges" type="object" string="Save" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="z" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
