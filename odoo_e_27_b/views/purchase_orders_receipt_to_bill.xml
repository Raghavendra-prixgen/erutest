<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="action_purchase_orders_to_bill" model="ir.actions.act_window">
        <field name="name">Receipt To Bill</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form,calendar,graph,pivot,kanban,activity</field>
        <field name="context">{'create': False}</field>
        <field name="domain">[('invoice_status','=','to invoice')]</field>
        <field name="search_view_id" ref="purchase.view_purchase_order_filter"/>
        <field name="view_id" ref="purchase.purchase_order_view_tree"/>
    </record>

    <menuitem id="menu_purchase_billing"
    name="Receipt to Bill"
    parent="purchase.menu_purchase_root" 
    sequence="1">

    <menuitem id="menu_purchase_order_bill"
        action="action_purchase_orders_to_bill"
        sequence="10"/>


</menuitem>
</odoo>