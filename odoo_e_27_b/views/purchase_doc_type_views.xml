<odoo>
  <data>
    <record id="purchase.purchase_rfq" model="ir.actions.act_window">
      <field name="domain">[('state','in',('sent','to approve','draft','reject'))]</field>
    </record>
    
<record id="purchase.purchase_form_action" model="ir.actions.act_window">
    <field name="domain">[('state','in',('purchase','done','cancel'))]</field>
    </record>
    
    <record id="view_purchase_order_doc_type" model="ir.ui.view">
      <field name="name">view_purchase.order.form.doc.type</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="purchase.view_partner_property_form"/>
      <field name="arch" type="xml">
        <field name="property_purchase_currency_id" position="after">
          <field name="y_purchase_doc_type_id" groups="base.group_no_one" options="{'no_create': True,'no_open': True,'no_create_edit':True}" />
        </field>
      </field>                   
    </record>

    
    <record id="view_order_form" model="ir.ui.view">
      <field name="name">purchase.order.inherit.view.form</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">
        <!-- <xpath expr="//field[@name='fiscal_position_id']" position="after">
          <field name="y_quotation_list_id" string="Copy RFQ's" options="{'no_create': True, 'no_open': True}" readonly="requisition_id == False or partner_id == False or  state  not in ['draft', 'sent']" invisible="1"/>
        </xpath> -->
        <field name="user_id" position="before">
          <field name="y_quotation_number" readonly="True"/>
          <field name="y_purchase_request_number" readonly="True"/>
        </field>
        <field name="date_order" position="before">
          <field name="y_doc_type_id" options="{'no_create': True, 'no_open': True}"  required="state == 'purchase'" readonly="state == 'purchase'"/>
        </field>
        <!-- <field name="partner_id" position="before">
          <field name="y_origin_order_id" readonly="True" invisible="not y_origin_order_id"/>
          <field name="y_revision_order_ids" widget="many2many_tags" readonly="True" invisible="True"/>
        </field> -->
      </field>
    </record>

    <record id="purchase_doc_type_view_tree" model="ir.ui.view">
      <field name="name">purchase.doc.type.view.tree</field>
      <field name="model">purchase.doc.type</field>
      <field name="arch" type="xml">
        <tree>
          <field name="y_name" required="True" />
          <field name="y_description" />
          <field name="y_product_group" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>

          <field name="y_sequence_id" required="True" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
          <field name="y_company_id" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}" groups="base.group_multi_company"/>
        </tree>
      </field>
    </record>

    <record id="purchase_doc_type_view_form" model="ir.ui.view">
      <field name="name">purchase.doc.type.view.form</field>
      <field name="model">purchase.doc.type</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>
            <group>
              <group>
              <field name="y_name" required="True"/>
              <field name="y_description" string="Description"/>
              <field name="y_product_group" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>

            </group>
            <group>
              <field name="y_sequence_id" required="True" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="y_company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" groups="base.group_multi_company"/>
            </group>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
            <field name="message_ids" widget="mail_thread"/>
        </div>
        </form>
      </field>
    </record>

    <record model="ir.rule" id="document_record_restricted_company_rule">
        <field name="name">Document Restricted Record: multi-company</field>
        <field name="model_id" ref="model_purchase_doc_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('y_company_id', '=', False), ('y_company_id', 'in', company_ids)]
        </field>
    </record>


    <record id="purchase_doc_type_action" model="ir.actions.act_window">
      <field name="name">Document Type</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">purchase.doc.type</field>
      <field name="view_mode">tree,form</field>
    </record>

    

    <menuitem id="menu_product_in_config_purchase_others" name="Others"
            parent="purchase.menu_purchase_config" sequence="45"/>

    <menuitem id="purchase_doc_type_menu_act" name="Document Type" parent="odoo_e_27_b.menu_product_in_config_purchase_others" action="purchase_doc_type_action" sequence="100"/>
  </data>
</odoo>