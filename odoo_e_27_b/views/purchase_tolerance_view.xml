<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="purchase_tolerance_inventry_inherited">
            <field name="name">purchase tolerance inventry.inheriter</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>    
            <field name="arch" type="xml">
              <group name="bill" position="after">
                    <group>
                        <field name="y_purchase_tol_reqd"/>
                        <label for="y_purchase_tolerance" invisible="not y_purchase_tol_reqd"/> 
                        <div class="o_row">               
                            <field name="y_purchase_tolerance" class="oe_inline" style="vertical-align:baseline" invisible="not y_purchase_tol_reqd" required='1'/>
                        </div>
                    </group>
                </group>

                <xpath expr="//field[@name='purchase_method']" position="after">
                    <field name="y_product_group_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </xpath>
            </field>                   
        </record>
    </data>
</odoo>     