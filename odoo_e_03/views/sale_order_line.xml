<odoo>
    <data>
        <record id="sh_pol_sale_line_tree_view_inherit" model="ir.ui.view">
            <field name="name">sale Order Line Tree</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="y_client_order_ref" optional="hide"/>
                    <field name="order_id" string="Order"/>
                    <field name="y_order_date" widget="date" optional='show'/>
                    <field name="scheduled_date" widget="date" optional="show"/>
                    <field name="y_so_expected_date" widget="date" optional="show"/>
                    <field name="y_so_effective_date" widget="date" optional="show"/>
                    <field name="product_id"/>
                    <field name="y_product_catag_id" optional="show"/>
                    <field name="name" optional='show'/>
                    <field name="y_partner_id"/>
                    <!-- <field name="analytic_groupby_account_ids" widget="many2many_tags" /> -->
                    <field name="product_uom_qty" string="Quantity"/>
                    <field name="qty_delivered" string= "Delivered Quantity"/>
                    <field name="qty_invoiced"/>
                    <field name="y_remaining_qty"/>
                    <field name="y_pending_order_value"/>
                    <field name="customer_lead"/>
                    <field name="price_unit"/>
                    <field name="currency_id" string="Currency" optional='show'/>
                    <field name="tax_id" widget="many2many_tags" optional='show'/>
                    <field name="price_subtotal"/>
                    <field name="y_status" decoration-info="y_status == 'Pending for Invoice'"
                           decoration-danger="y_status == 'Cancel'" decoration-success="y_status == 'Pending Order'"/>
                    <field name="state"  optional='show'/>
                    <!-- <field name="y_open_close_so" optional='show'/> -->
                </tree>
            </field>
        </record>

        <record id="sh_pol_sale_line_search_view_inherit" model="ir.ui.view">
            <field name="name">sale Order Line Tree</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="y_product_group_1"/>
                    <field name="y_product_group_2"/>
                    <field name="y_product_group_3"/>
                    <field name="y_item_group"/>
                    <separator orientation="vertical"/>
                    <filter string="Order Confirm Date" name="filter_create_date" date="y_order_date"/>
                    <searchpanel>
						<field name="y_partner_id"/>
						<field name="order_id" />
						<field name="product_id"/>
                    </searchpanel>
                   <!--  <separator/>
                    <filter string="OPEN SO" name="open_so" domain="[('y_open_close_so', '=', 'open_so' )]"/>
                    <filter string="CLOSE SO" name="close_so" domain="[('y_open_close_so', '=', 'close_so' )]"/> -->
                </xpath>
                <filter name='product' position='after'>
                    <filter string="Status" name="y_status" domain="[]" context="{'group_by':'y_status'}"/>                    
                    <filter string="Product Group 1" name="y_product_group_1" domain="[]" context="{'group_by':'y_product_group_1'}"/>
                    <filter string="Product Group 2" name="y_product_group_2" domain="[]" context="{'group_by':'y_product_group_2'}"/>
                    <filter string="Product Group 3" name="y_product_group_3" domain="[]" context="{'group_by':'y_product_group_3'}"/>
                    <filter string="Item Group" name="y_item_group" domain="[]" context="{'group_by':'y_item_group'}"/>
                    <filter string="Delivered Quantity" name="qty_delivered" domain="[]" context="{'group_by':'qty_delivered'}"/>
                </filter>
                <filter name='y_status' position='after'>
                    <filter string="Product Category" name="y_product_catag_id" domain="[]"
                            context="{'group_by':'y_product_catag_id'}"/>
                    <!-- <filter string="Order Status" name="y_open_close_so" context="{'group_by':'y_open_close_so'}"/> -->
                    <!--<separator orientation="vertical"/>-->
                    <filter string="Order Confirm Date" name="y_order_date" context="{'group_by':'y_order_date'}"/>
                </filter>
            </field>
        </record>


        <record id="sh_action_sale_order_lines" model="ir.actions.act_window">
            <field name="name">SO Status Report</field>
            <field name="res_model">sale.order.line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="target">current</field>
            <field name="domain">[('state','in',('sale','done','cancel'))]</field>
            <field name="view_id" ref="sh_pol_sale_line_tree_view_inherit"/>
        </record>


        <menuitem id="sh_sol_order_line" name="SO Status Report" action="sh_action_sale_order_lines" parent="sale.menu_sale_report"/>

    	<record id="ir_action_update_sol_groups"
    		model="ir.actions.server">
    		<field name="name">Update Sale Order Line</field>
    		<field name="model_id" ref="model_sale_order" />
    		<field name="binding_model_id" ref="model_sale_order" />
    		<field name="binding_view_types">list</field>
    		<field name="state">code</field>
    		<field name="code">
    			if records:
    			    action = records.update_sol_groups()
    		</field>
    	</record>

    </data>
</odoo>
